# Strict mode still checks the candidate when the requested subinterval has no slots.
statement error
SELECT count(*) FROM read_om_series(
    '__WORKING_DIRECTORY__/build/series-fixtures/data/gaps/all-missing/temperature',
    chunk_time_length := 4, time_step := INTERVAL '1 hour', strict := true,
    dimensions := ['lead','point','time'],
    grid := {'nx':3,'ny':2,'lat0':10.0,'lon0':100.0,'dlat':1.0,'dlon':1.0,'order':'lon_fastest'},
    spatial_axes := ['point'],
    start := TIMESTAMP '1970-01-01 00:00:00.000001', "end" := TIMESTAMP '1970-01-01 00:59:59.999999'
);
----
<REGEX>:(?i).*(could not open|no such file|not found|missing).*

# A slotless first candidate remains subject to strict presence checks when later chunks contribute rows.
statement error
SELECT count(*) FROM read_om_series(
    '__WORKING_DIRECTORY__/build/series-fixtures/data/gaps/first-missing/temperature',
    chunk_time_length := 4, time_step := INTERVAL '1 hour', strict := true,
    dimensions := ['lead','point','time'],
    grid := {'nx':3,'ny':2,'lat0':10.0,'lon0':100.0,'dlat':1.0,'dlon':1.0,'order':'lon_fastest'},
    spatial_axes := ['point'],
    start := TIMESTAMP '1970-01-01 03:00:00.000001', "end" := TIMESTAMP '1970-01-01 05:00:00'
);
----
<REGEX>:(?i).*(could not open|no such file|not found|missing).*

# A present slotless candidate is bound for validation but contributes no rows.
query I
SELECT count(*)::INTEGER
FROM read_om_series(
    '__WORKING_DIRECTORY__/build/series-fixtures/data/synthetic/temperature',
    chunk_time_length := 4, time_step := INTERVAL '1 hour', strict := true,
    dimensions := ['lead','point','time'],
    grid := {'nx':3,'ny':2,'lat0':10.0,'lon0':100.0,'dlat':1.0,'dlon':1.0,'order':'lon_fastest'},
    spatial_axes := ['point'],
    start := TIMESTAMP '1970-01-01 03:00:00.000001', "end" := TIMESTAMP '1970-01-01 03:59:59.999999'
);
----
0
