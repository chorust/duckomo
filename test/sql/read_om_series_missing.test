# name: test/sql/read_om_series_missing.test
# description: Validate default missing-chunk skip, strict validation, and declared empty schemas
# group: [duckomo]

require skip_reload

require allow_unsigned_extensions

statement ok
LOAD '__BUILD_DIRECTORY__/extension/duckomo/duckomo.duckdb_extension';

# Missing first, middle, and last candidates contribute no filler rows. The one
# existing NaN in chunk 1 remains a NULL value row, distinct from absence.
query III
SELECT count(*)::INTEGER, count(value)::INTEGER,
       count(*) FILTER (WHERE value IS NULL)::INTEGER
FROM read_om_series(
    '__WORKING_DIRECTORY__/build/series-fixtures/data/gaps/first-missing/temperature',
    chunk_time_length := 4, time_step := INTERVAL '1 hour',
    dimensions := ['lead','point','time'],
    grid := {'nx':3,'ny':2,'lat0':10.0,'lon0':100.0,'dlat':1.0,'dlon':1.0,'order':'lon_fastest'},
    spatial_axes := ['point'],
    valid_times := [TIMESTAMP '1970-01-01 00:00:00', TIMESTAMP '1970-01-01 11:00:00']
);
----
48	47	1

query III
SELECT count(*)::INTEGER, count(value)::INTEGER,
       count(*) FILTER (WHERE value IS NULL)::INTEGER
FROM read_om_series(
