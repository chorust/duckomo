# An all-missing default query is a typed empty relation with no fabricated rows.
query I
SELECT count(*)::INTEGER
FROM read_om_series(
    '__WORKING_DIRECTORY__/build/series-fixtures/data/gaps/all-missing/temperature',
    chunk_time_length := 4, time_step := INTERVAL '1 hour',
    dimensions := ['lead','point','time'],
    grid := {'nx':3,'ny':2,'lat0':10.0,'lon0':100.0,'dlat':1.0,'dlon':1.0,'order':'lon_fastest'},
    spatial_axes := ['point'],
    valid_times := [TIMESTAMP '1970-01-01 00:00:00', TIMESTAMP '1970-01-01 01:00:00']
);
----
0

# Metadata-free all-missing root schema matches a present root object.
query I
WITH empty_schema AS (
    SELECT column_name, column_type
    FROM (DESCRIBE SELECT * FROM read_om_series(
        '__WORKING_DIRECTORY__/build/series-fixtures/data/gaps/all-missing/temperature',
        chunk_time_length := 4, time_step := INTERVAL '1 hour',
        dimensions := ['lead','point','time'],
        grid := {'nx':3,'ny':2,'lat0':10.0,'lon0':100.0,'dlat':1.0,'dlon':1.0,'order':'lon_fastest'},
        spatial_axes := ['point'],
        valid_times := [TIMESTAMP '1970-01-01 00:00:00', TIMESTAMP '1970-01-01 01:00:00']
    ))
), present_schema AS (
    SELECT column_name, column_type
    FROM (DESCRIBE SELECT * FROM read_om_series(
        '__WORKING_DIRECTORY__/build/series-fixtures/data/synthetic/temperature',
        chunk_time_length := 4, time_step := INTERVAL '1 hour',
        dimensions := ['lead','point','time'],
        grid := {'nx':3,'ny':2,'lat0':10.0,'lon0':100.0,'dlat':1.0,'dlon':1.0,'order':'lon_fastest'},
        spatial_axes := ['point'],
        valid_times := [TIMESTAMP '1970-01-01 00:00:00', TIMESTAMP '1970-01-01 01:00:00']
    ))
)
SELECT (SELECT count(*) FROM (SELECT * FROM empty_schema EXCEPT ALL SELECT * FROM present_schema))
     + (SELECT count(*) FROM (SELECT * FROM present_schema EXCEPT ALL SELECT * FROM empty_schema));
----
0

# A declared named-array map keeps its exact output schema when no file exists.
query I
WITH empty_schema AS (
    SELECT column_name, column_type
    FROM (DESCRIBE SELECT * FROM read_om_series(
        '__WORKING_DIRECTORY__/build/series-fixtures/data/gaps/all-missing/temperature',
        chunk_time_length := 4, time_step := INTERVAL '1 hour',
        dimensions := map(['/temperature','/humidity'],
                         [['lead','point','time'],['lead','point','time']]),
        grid := {'nx':3,'ny':2,'lat0':10.0,'lon0':100.0,'dlat':1.0,'dlon':1.0,'order':'lon_fastest'},
        spatial_axes := ['point'],
        valid_times := [TIMESTAMP '1970-01-01 00:00:00', TIMESTAMP '1970-01-01 01:00:00']
    ))
), present_schema AS (
    SELECT column_name, column_type
    FROM (DESCRIBE SELECT * FROM read_om_series(
        '__WORKING_DIRECTORY__/build/series-fixtures/data/named/temperature',
        chunk_time_length := 4, time_step := INTERVAL '1 hour',
        dimensions := map(['/temperature','/humidity'],
                         [['lead','point','time'],['lead','point','time']]),
        grid := {'nx':3,'ny':2,'lat0':10.0,'lon0':100.0,'dlat':1.0,'dlon':1.0,'order':'lon_fastest'},
        spatial_axes := ['point'],
        valid_times := [TIMESTAMP '1970-01-01 00:00:00', TIMESTAMP '1970-01-01 01:00:00']
    ))
)
SELECT (SELECT count(*) FROM (SELECT * FROM empty_schema EXCEPT ALL SELECT * FROM present_schema))
     + (SELECT count(*) FROM (SELECT * FROM present_schema EXCEPT ALL SELECT * FROM empty_schema));
----
0

# A variable selector narrows the declaration identically for empty and present data.
query I
WITH empty_schema AS (
    SELECT column_name, column_type
    FROM (DESCRIBE SELECT * FROM read_om_series(
        '__WORKING_DIRECTORY__/build/series-fixtures/data/gaps/all-missing/temperature',
        chunk_time_length := 4, time_step := INTERVAL '1 hour', variable := 'temperature',
        dimensions := map(['/temperature'], [['lead','point','time']]),
        grid := {'nx':3,'ny':2,'lat0':10.0,'lon0':100.0,'dlat':1.0,'dlon':1.0,'order':'lon_fastest'},
        spatial_axes := ['point'],
        valid_times := [TIMESTAMP '1970-01-01 00:00:00', TIMESTAMP '1970-01-01 01:00:00']
    ))
), present_schema AS (
    SELECT column_name, column_type
    FROM (DESCRIBE SELECT * FROM read_om_series(
        '__WORKING_DIRECTORY__/build/series-fixtures/data/named/temperature',
        chunk_time_length := 4, time_step := INTERVAL '1 hour', variable := 'temperature',
        dimensions := map(['/temperature'], [['lead','point','time']]),
        grid := {'nx':3,'ny':2,'lat0':10.0,'lon0':100.0,'dlat':1.0,'dlon':1.0,'order':'lon_fastest'},
        spatial_axes := ['point'],
        valid_times := [TIMESTAMP '1970-01-01 00:00:00', TIMESTAMP '1970-01-01 01:00:00']
    ))
)
SELECT (SELECT count(*) FROM (SELECT * FROM empty_schema EXCEPT ALL SELECT * FROM present_schema))
     + (SELECT count(*) FROM (SELECT * FROM present_schema EXCEPT ALL SELECT * FROM empty_schema));
----
0

# include_source keeps its existing STRUCT type for all-missing declarations.
query I
WITH empty_schema AS (
    SELECT column_name, column_type
    FROM (DESCRIBE SELECT * FROM read_om_series(
        '__WORKING_DIRECTORY__/build/series-fixtures/data/gaps/all-missing/temperature',
        chunk_time_length := 4, time_step := INTERVAL '1 hour', include_source := true,
        dimensions := ['lead','point','time'],
        grid := {'nx':3,'ny':2,'lat0':10.0,'lon0':100.0,'dlat':1.0,'dlon':1.0,'order':'lon_fastest'},
        spatial_axes := ['point'],
        valid_times := [TIMESTAMP '1970-01-01 00:00:00', TIMESTAMP '1970-01-01 01:00:00']
    ))
), present_schema AS (
    SELECT column_name, column_type
    FROM (DESCRIBE SELECT * FROM read_om_series(
        '__WORKING_DIRECTORY__/build/series-fixtures/data/synthetic/temperature',
        chunk_time_length := 4, time_step := INTERVAL '1 hour', include_source := true,
        dimensions := ['lead','point','time'],
        grid := {'nx':3,'ny':2,'lat0':10.0,'lon0':100.0,'dlat':1.0,'dlon':1.0,'order':'lon_fastest'},
        spatial_axes := ['point'],
        valid_times := [TIMESTAMP '1970-01-01 00:00:00', TIMESTAMP '1970-01-01 01:00:00']
    ))
)
SELECT (SELECT count(*) FROM (SELECT * FROM empty_schema EXCEPT ALL SELECT * FROM present_schema))
     + (SELECT count(*) FROM (SELECT * FROM present_schema EXCEPT ALL SELECT * FROM empty_schema));
----
0

# Strict mode rejects every missing-position pattern, including all-missing input.
statement error
SELECT count(*) FROM read_om_series(
    '__WORKING_DIRECTORY__/build/series-fixtures/data/gaps/first-missing/temperature',
    chunk_time_length := 4, time_step := INTERVAL '1 hour', strict := true,
    dimensions := ['lead','point','time'],
    grid := {'nx':3,'ny':2,'lat0':10.0,'lon0':100.0,'dlat':1.0,'dlon':1.0,'order':'lon_fastest'},
    spatial_axes := ['point'],
    valid_times := [TIMESTAMP '1970-01-01 00:00:00', TIMESTAMP '1970-01-01 11:00:00']
);
----
