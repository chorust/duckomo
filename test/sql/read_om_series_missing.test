# Strict validation is a bind-time obligation, so outer operators cannot bypass it.
statement error
SELECT * FROM read_om_series(
    '__WORKING_DIRECTORY__/build/series-fixtures/data/gaps/first-missing/temperature',
    chunk_time_length := 4, time_step := INTERVAL '1 hour', strict := true,
    dimensions := ['lead','point','time'],
    grid := {'nx':3,'ny':2,'lat0':10.0,'lon0':100.0,'dlat':1.0,'dlon':1.0,'order':'lon_fastest'},
    spatial_axes := ['point'],
    valid_times := [TIMESTAMP '1970-01-01 00:00:00', TIMESTAMP '1970-01-01 11:00:00']
)
LIMIT 0;
----
<REGEX>:(?i).*(could not open|no such file|not found|missing).*

statement error
SELECT * FROM read_om_series(
    '__WORKING_DIRECTORY__/build/series-fixtures/data/gaps/middle-missing/temperature',
    chunk_time_length := 4, time_step := INTERVAL '1 hour', strict := true,
    dimensions := ['lead','point','time'],
    grid := {'nx':3,'ny':2,'lat0':10.0,'lon0':100.0,'dlat':1.0,'dlon':1.0,'order':'lon_fastest'},
    spatial_axes := ['point'],
    valid_times := [TIMESTAMP '1970-01-01 00:00:00', TIMESTAMP '1970-01-01 11:00:00']
)
WHERE valid_time >= TIMESTAMP '1970-01-01 08:00:00';
