# SQL aggregation is equal-weight over non-NULL source points and preserves empty/all-NULL distinctions.
query T
SELECT count(*)::VARCHAR || '/' || count(value)::VARCHAR || '/' || sum(value)::VARCHAR || '/' ||
       avg(value)::VARCHAR || '/' || min(value)::VARCHAR || '/' || max(value)::VARCHAR
FROM region_samples
WHERE region_id='A' AND member=0 AND valid_time=TIMESTAMP '2026-01-01 00:00:00';
----
9/8/77.0/9.625/0.0/21.0

query T
SELECT count(*)::VARCHAR || '/' || count(value)::VARCHAR || '/' || coalesce(sum(value)::VARCHAR,'NULL') || '/' ||
       coalesce(avg(value)::VARCHAR,'NULL')
FROM region_samples
WHERE region_id='A' AND member=0 AND valid_time=TIMESTAMP '2026-01-01 02:00:00';
----
9/0/NULL/NULL

statement ok
CREATE TEMP TABLE region_statistics AS
SELECT region_id, valid_time, member, count(*) AS sample_count, count(value) AS valid_count,
       sum(value) AS sum_value, avg(value) AS avg_value, min(value) AS min_value, max(value) AS max_value
FROM region_samples
GROUP BY region_id, valid_time, member;

statement ok
CREATE TEMP TABLE expected_region_statistics AS
SELECT * FROM read_csv_auto('__WORKING_DIRECTORY__/test/data/regions/regions-statistics.reference.csv',
                            header=true, nullstr='');

statement ok
CREATE TEMP TABLE complete_region_statistics AS
SELECT r.region_id, t.valid_time, m.member,
       coalesce(s.sample_count, 0) AS sample_count,
       coalesce(s.valid_count, 0) AS valid_count,
       s.sum_value, s.avg_value, s.min_value, s.max_value
FROM region_shapes r
CROSS JOIN (SELECT DISTINCT valid_time FROM full_baseline) t
CROSS JOIN (SELECT DISTINCT member FROM full_baseline) m
LEFT JOIN region_statistics s USING (region_id, valid_time, member);

# The complete 10 x 3 x 2 SQL result matches the independent frozen oracle.
query II
WITH actual AS (
    SELECT region_id, member, date_diff('hour', TIMESTAMP '2026-01-01 00:00:00', valid_time)::INTEGER AS time_index,
           sample_count, valid_count, sum_value, avg_value, min_value, max_value
    FROM complete_region_statistics
), compared AS (
    SELECT e.*, a.sample_count AS actual_sample_count, a.valid_count AS actual_valid_count,
           a.sum_value AS actual_sum, a.avg_value AS actual_mean,
           a.min_value AS actual_min, a.max_value AS actual_max,
           e.region_id IS NOT NULL AS expected_present, a.region_id IS NOT NULL AS actual_present
    FROM expected_region_statistics e
    FULL OUTER JOIN actual a USING (region_id, member, time_index)
)
SELECT count(*)::INTEGER,
       count(*) FILTER (WHERE
           NOT expected_present OR NOT actual_present OR sample_count != actual_sample_count OR
           valid_count != actual_valid_count OR
           (sum IS NULL) != (actual_sum IS NULL) OR
           (sum IS NOT NULL AND abs(sum - actual_sum) > greatest(1e-6, 1e-6 * abs(sum))) OR
           (mean IS NULL) != (actual_mean IS NULL) OR
           (mean IS NOT NULL AND abs(mean - actual_mean) > greatest(1e-6, 1e-6 * abs(mean))) OR
           (min IS NULL) != (actual_min IS NULL) OR (min IS NOT NULL AND min != actual_min) OR
           (max IS NULL) != (actual_max IS NULL) OR (max IS NOT NULL AND max != actual_max))::INTEGER
FROM compared;
----
60	0

query I
SELECT count(*) FROM region_shapes r
CROSS JOIN (SELECT DISTINCT valid_time FROM full_baseline) t
CROSS JOIN (SELECT DISTINCT member FROM full_baseline) m
LEFT JOIN region_statistics s USING (region_id, valid_time, member);
----
60

query T
SELECT coalesce(sum(sample_count),0)::VARCHAR || '/' || coalesce(sum(valid_count),0)::VARCHAR || '/' ||
       coalesce(sum(sum_value)::VARCHAR,'NULL')
FROM region_shapes r
CROSS JOIN (SELECT DISTINCT valid_time FROM full_baseline) t
CROSS JOIN (SELECT DISTINCT member FROM full_baseline) m
LEFT JOIN region_statistics s USING (region_id, valid_time, member)
WHERE r.region_id IN ('Empty','Outside','Gap');
----
0/0/NULL

# Repeated labels merge only in SQL aggregation; distinct logical source positions remain available.
statement ok
SET VARIABLE repeated_time_region = (
    SELECT [{'id':'A','wkb':ST_AsWKB(ST_GeomFromText('POLYGON((100 20,102 20,102 22,100 22,100 20))'))}]
);

query T
SELECT valid_time::VARCHAR || '/' || member::VARCHAR || '/' || count(*)::VARCHAR || '/' ||
       count(DISTINCT om_source.logical_index)::VARCHAR
FROM read_om_regions(
    '__WORKING_DIRECTORY__/test/data/regions/regions_axis_order.om',
    regions := getvariable('repeated_time_region'), region_crs := 'grid_lonlat',
    dimensions := ['time','member','lat','lon'],
    grid := {'nx':5,'ny':5,'lat0':20.0,'lon0':100.0,'dlat':1.0,'dlon':1.0,'order':'separate'},
    spatial_axes := ['lat','lon'], axes := {
        'time':{'axis':'time','values':[TIMESTAMP '2026-01-01 00:00:00',
                                      TIMESTAMP '2026-01-01 00:00:00',
                                      TIMESTAMP '2026-01-01 01:00:00']},
        'member':{'axis':'member','values':[0::BIGINT,1::BIGINT]}}, include_source := true)
GROUP BY valid_time, member ORDER BY valid_time, member;
----
2026-01-01 00:00:00/0/18/18
2026-01-01 00:00:00/1/18/18
2026-01-01 01:00:00/0/9/9
2026-01-01 01:00:00/1/9/9

# NaN remains NULL, while infinities and their host aggregate behavior stay visible.
statement ok
SET VARIABLE nonfinite_regions = [
    {'id':'All','wkb':ST_AsWKB(ST_GeomFromText('POLYGON((-0.5 -0.5,1.5 -0.5,1.5 1.5,-0.5 1.5,-0.5 -0.5))'))}
];

query T
SELECT count(*)::VARCHAR || '/' || count(value)::VARCHAR || '/' ||
       (isinf(min(value)) AND min(value) < 0)::VARCHAR || '/' ||
       (isinf(max(value)) AND max(value) > 0)::VARCHAR || '/' ||
       isnan(sum(value))::VARCHAR || '/' || isnan(avg(value))::VARCHAR
FROM read_om_regions(
    '__WORKING_DIRECTORY__/test/data/regions/regions_nonfinite.om',
    regions := getvariable('nonfinite_regions'), region_crs := 'grid_lonlat',
    dimensions := ['lat','lon'],
    grid := {'nx':2,'ny':2,'lat0':0.0,'lon0':0.0,'dlat':1.0,'dlon':1.0,'order':'separate'},
    spatial_axes := ['lat','lon']);
----
4/3/true/true/true/true

