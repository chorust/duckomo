# name: test/sql/regions.test
# description: Validate region binding, exact row semantics, source identity, and aggregation composition
# group: [duckomo]

require skip_reload

require allow_unsigned_extensions

# Ordinary test_release needs no spatial package. The region validator provides
# this path only after verifying the matching runtime identity and artifact hash.
require-env DUCKOMO_SPATIAL_EXTENSION

statement ok
LOAD '__BUILD_DIRECTORY__/extension/duckomo/duckomo.duckdb_extension';

statement ok
LOAD '${DUCKOMO_SPATIAL_EXTENSION}';

statement ok
CREATE TEMP TABLE region_shapes(region_id VARCHAR, geom GEOMETRY);

statement ok
INSERT INTO region_shapes VALUES
    ('A', ST_GeomFromText('POLYGON((100 20,102 20,102 22,100 22,100 20))')),
    ('B', ST_GeomFromText('POLYGON((101 21,103 21,103 23,101 23,101 21))')),
    ('Hole', ST_GeomFromText('POLYGON((100 20,104 20,104 24,100 24,100 20),(101 21,103 21,103 23,101 23,101 21))')),
    ('Empty', ST_GeomFromText('POLYGON EMPTY')),
    ('Outside', ST_GeomFromText('POLYGON((110 30,111 30,111 31,110 31,110 30))')),
    ('Multi', ST_GeomFromText('MULTIPOLYGON(((100 20,101 20,101 21,100 21,100 20)),((103 23,104 23,104 24,103 24,103 23)))')),
    ('CopyA', ST_GeomFromText('POLYGON((100 20,102 20,102 22,100 22,100 20))')),
    ('Narrow', ST_GeomFromText('POLYGON((100 20,100.2 20,100.2 24,100 24,100 20))')),
    ('Gap', ST_GeomFromText('POLYGON((100.1 20.1,100.2 20.1,100.2 20.2,100.1 20.2,100.1 20.1))')),
    ('Corner', ST_GeomFromText('POLYGON((102 22,104 22,104 24,102 24,102 22))'));

statement ok
SET VARIABLE region_input = (
    SELECT COALESCE(list({'id':region_id, 'wkb':ST_AsWKB(geom)} ORDER BY region_id),
                    []::STRUCT(id VARCHAR,wkb BLOB)[])
    FROM region_shapes
);

statement ok
SET VARIABLE demo_grid = {'nx':5,'ny':5,'lat0':20.0,'lon0':100.0,
                          'dlat':1.0,'dlon':1.0,'order':'separate'};

statement ok
SET VARIABLE demo_axes = {
    'time':{'axis':'time','start':TIMESTAMP '2026-01-01 00:00:00','step':INTERVAL '1 hour'},
    'member':{'axis':'member','values':[0::BIGINT,1::BIGINT]}
};

statement ok
CREATE TEMP VIEW region_samples AS
SELECT * FROM read_om_regions(
    '__WORKING_DIRECTORY__/test/data/regions/regions.om',
    regions := getvariable('region_input'), region_crs := 'grid_lonlat',
    dimensions := ['member','time','lat','lon'], grid := getvariable('demo_grid'),
    spatial_axes := ['lat','lon'], axes := getvariable('demo_axes'), include_source := true);

statement ok
CREATE TEMP VIEW region_samples_explicit_points AS
SELECT * FROM read_om_regions(
    '__WORKING_DIRECTORY__/test/data/regions/regions.om',
    regions := getvariable('region_input'), region_crs := 'grid_lonlat',
    dimensions := ['member','time','lat','lon'], grid := getvariable('demo_grid'),
    spatial_axes := ['lat','lon'], axes := getvariable('demo_axes'),
    method := 'points', include_source := true);

# Omitted method and explicit points preserve every value, NULL, and source field.
query I
WITH differences AS (
    (SELECT * FROM region_samples EXCEPT ALL SELECT * FROM region_samples_explicit_points)
    UNION ALL
    (SELECT * FROM region_samples_explicit_points EXCEPT ALL SELECT * FROM region_samples)
)
SELECT count(*) FROM differences;
----
0

query I
WITH omitted AS (
    SELECT column_name, column_type FROM (DESCRIBE SELECT * FROM region_samples)
), explicit_points AS (
    SELECT column_name, column_type FROM (DESCRIBE SELECT * FROM region_samples_explicit_points)
), differences AS (
    (SELECT * FROM omitted EXCEPT ALL SELECT * FROM explicit_points)
    UNION ALL
    (SELECT * FROM explicit_points EXCEPT ALL SELECT * FROM omitted)
)
SELECT count(*) FROM differences;
----
0

# The stable row shape appends region_id and leaves om_source last.
query T
SELECT column_name || ' ' || column_type
FROM (DESCRIBE SELECT * FROM read_om_regions(
    '__WORKING_DIRECTORY__/test/data/regions/regions.om',
    regions := getvariable('region_input'), region_crs := 'grid_lonlat',
    dimensions := ['member','time','lat','lon'], grid := getvariable('demo_grid'),
    spatial_axes := ['lat','lon'], axes := getvariable('demo_axes')));
----
value FLOAT
lat DOUBLE
lon DOUBLE
valid_time TIMESTAMP
member BIGINT
region_id VARCHAR

query T
SELECT column_name || ' ' || column_type
FROM (DESCRIBE SELECT * FROM region_samples);
----
value FLOAT
lat DOUBLE
lon DOUBLE
valid_time TIMESTAMP
member BIGINT
region_id VARCHAR
om_source STRUCT(object_id VARCHAR, object_version VARCHAR, version_strength VARCHAR, content_verified BOOLEAN, grid_id VARCHAR, layout_id VARCHAR, logical_index UBIGINT, point_index UBIGINT, parent_point_index UBIGINT, axis_indices UBIGINT[])

# A literal list with reversed STRUCT field order binds just like getvariable input.
query I
SELECT count(*) FROM read_om_regions(
    '__WORKING_DIRECTORY__/test/data/regions/regions.om',
    regions := [{'wkb':ST_AsWKB(ST_GeomFromText('POLYGON((100 20,102 20,102 22,100 22,100 20))')),
                 'id':'Literal'}], region_crs := 'grid_lonlat',
    dimensions := ['member','time','lat','lon'], grid := getvariable('demo_grid'),
    spatial_axes := ['lat','lon'], axes := getvariable('demo_axes'));
----
54

