# The shared-spatial baseline checks scanner integration and candidate pruning.
statement ok
CREATE TEMP TABLE full_baseline AS
SELECT * FROM read_om(
    '__WORKING_DIRECTORY__/test/data/regions/regions.om',
    dimensions := ['member','time','lat','lon'], grid := getvariable('demo_grid'),
    spatial_axes := ['lat','lon'], axes := getvariable('demo_axes'), include_source := true);

statement ok
CREATE TEMP TABLE expected_region_samples AS
SELECT r.region_id, b.om_source.logical_index AS logical_index,
       b.value, b.lat, b.lon, b.valid_time, b.member
FROM full_baseline b CROSS JOIN region_shapes r
WHERE ST_Covers(r.geom, ST_Point(b.lon, b.lat));

statement ok
CREATE TEMP TABLE actual_region_samples AS
SELECT region_id, om_source.logical_index AS logical_index,
       value, lat, lon, valid_time, member
FROM region_samples;

query I
SELECT count(*) FROM actual_region_samples;
----
438

query II
SELECT
    (SELECT count(*) FROM (SELECT * FROM expected_region_samples EXCEPT ALL SELECT * FROM actual_region_samples)),
    (SELECT count(*) FROM (SELECT * FROM actual_region_samples EXCEPT ALL SELECT * FROM expected_region_samples));
----
0	0

# The frozen Python membership oracle is independent of spatial and the scanner.
# Exact typed rows include source positions, coordinates, Float32 values, and NULLs;
# EXCEPT ALL in both directions also detects missing or duplicated memberships.
statement ok
CREATE TEMP TABLE independent_region_samples AS
SELECT * FROM read_csv('__WORKING_DIRECTORY__/test/data/regions/regions-membership.reference.csv',
    header=true, nullstr='', columns={
        'region_id':'VARCHAR', 'logical_index':'UBIGINT', 'member':'BIGINT',
        'time_index':'INTEGER', 'lat':'DOUBLE', 'lon':'DOUBLE', 'value':'FLOAT'});

query III
WITH actual AS (
    SELECT region_id, logical_index, member,
           date_diff('hour', TIMESTAMP '2026-01-01 00:00:00', valid_time)::INTEGER AS time_index,
           lat, lon, value
    FROM actual_region_samples
)
SELECT
    (SELECT count(*) FROM independent_region_samples),
    (SELECT count(*) FROM (SELECT * FROM independent_region_samples EXCEPT ALL SELECT * FROM actual)),
    (SELECT count(*) FROM (SELECT * FROM actual EXCEPT ALL SELECT * FROM independent_region_samples));
----
438	0	0

