# A new prepare after rebinding the variable snapshots the changed region collection.
statement ok
SET VARIABLE region_input = (
    SELECT list({'id':region_id, 'wkb':ST_AsWKB(geom)}) FROM region_shapes WHERE region_id='A'
);

statement ok
PREPARE region_count AS SELECT count(*) FROM read_om_regions(
    '__WORKING_DIRECTORY__/test/data/regions/regions.om',
    regions := getvariable('region_input'), region_crs := 'grid_lonlat',
    dimensions := ['member','time','lat','lon'], grid := getvariable('demo_grid'),
    spatial_axes := ['lat','lon'], axes := getvariable('demo_axes'));

query I
EXECUTE region_count;
----
54

statement ok
DEALLOCATE region_count;

statement ok
SET VARIABLE region_input = (
    SELECT list({'id':region_id, 'wkb':ST_AsWKB(geom)}) FROM region_shapes WHERE region_id='Narrow'
);

statement ok
PREPARE region_count AS SELECT count(*) FROM read_om_regions(
    '__WORKING_DIRECTORY__/test/data/regions/regions.om',
    regions := getvariable('region_input'), region_crs := 'grid_lonlat',
    dimensions := ['member','time','lat','lon'], grid := getvariable('demo_grid'),
    spatial_axes := ['lat','lon'], axes := getvariable('demo_axes'));

query I
EXECUTE region_count;
----
30

statement ok
DEALLOCATE region_count;
