# name: test/sql/remote_async_io.test
# description: DuckDB 2.0 remote async I/O SQL settings, limits, and local isolation
# group: [duckomo]

require skip_reload

require allow_unsigned_extensions

statement ok
LOAD '__BUILD_DIRECTORY__/extension/duckomo/duckomo.duckdb_extension';

query I
SELECT current_setting('duckomo_async_io') = starts_with(version(), 'v2.');
----
true

query I
SELECT current_setting('duckomo_async_max_inflight')::INT;
----
8

statement ok
SET duckomo_async_max_inflight = 16;

query I
SELECT current_setting('duckomo_async_max_inflight')::INT;
----
16

statement error
SET duckomo_async_max_inflight = 0;
----
Invalid Input Error: duckomo_async_max_inflight must be between 1 and 256

statement error
SET duckomo_async_max_inflight = 512;
----
Invalid Input Error: duckomo_async_max_inflight must be between 1 and 256

statement ok
RESET duckomo_async_max_inflight;

query I
SELECT current_setting('duckomo_async_max_inflight')::INT;
----
8

statement ok
SET duckomo_async_io = false;

query I
SELECT current_setting('duckomo_async_io');
----
false

statement ok
SET duckomo_async_io = true;

query I
SELECT current_setting('duckomo_async_io');
----
true

statement ok
RESET duckomo_async_io;

query I
SELECT current_setting('duckomo_async_io') = starts_with(version(), 'v2.');
----
true

# Local scans with async_io enabled ignore remote async settings and produce identical results
statement ok
SET duckomo_async_io = true;

statement ok
SET duckomo_async_max_inflight = 32;

query I
SELECT sum(value) FROM read_om('__WORKING_DIRECTORY__/test/data/raw.om');
----
15.0

query I
SELECT contains(metrics, '"remote_io":null') FROM duckomo_last_scan_metrics();
----
true

statement ok
SET duckomo_async_io = false;

query I
SELECT sum(value) FROM read_om('__WORKING_DIRECTORY__/test/data/raw.om');
----
15.0

query I
SELECT contains(metrics, '"remote_io":null') FROM duckomo_last_scan_metrics();
----
true

statement ok
RESET duckomo_async_io;

statement ok
RESET duckomo_async_max_inflight;

# Cross-batch prefetch is opt-in after measured regressions.
query I
SELECT current_setting('duckomo_async_prefetch_batches')::INTEGER;
----
1

statement ok
SET duckomo_async_prefetch_batches=4;

statement error
SET duckomo_async_prefetch_batches=0;
----
duckomo_async_prefetch_batches must be between 1 and 4

statement ok
RESET duckomo_async_prefetch_batches;
