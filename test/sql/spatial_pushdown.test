# name: test/sql/spatial_pushdown.test
# description: Validate exact spatial predicate semantics and safe candidate selection
# group: [duckomo]

require skip_reload

require allow_unsigned_extensions

statement ok
LOAD '__BUILD_DIRECTORY__/extension/duckomo/duckomo.duckdb_extension';

query I
SELECT count(*) FROM read_om(
    '__WORKING_DIRECTORY__/test/data/raw.om',
    dimensions := map(['value'], [['lat','lon']]),
    grid := {'nx':3, 'ny':2, 'lat0':10.0, 'lon0':100.0, 'dlat':1.0, 'dlon':2.0, 'order':'separate'},
    spatial_axes := ['lat','lon']) WHERE latitude = 11;
----
3

query I
SELECT count(*) FROM read_om(
    '__WORKING_DIRECTORY__/test/data/raw.om',
    dimensions := map(['value'], [['lat','lon']]),
    grid := {'nx':3, 'ny':2, 'lat0':10.0, 'lon0':100.0, 'dlat':1.0, 'dlon':2.0, 'order':'separate'},
    spatial_axes := ['lat','lon']) WHERE 11 <= latitude AND longitude < 104;
----
2

query I
SELECT count(*) FROM read_om(
    '__WORKING_DIRECTORY__/test/data/raw.om',
    dimensions := map(['value'], [['lat','lon']]),
    grid := {'nx':3, 'ny':2, 'lat0':10.0, 'lon0':100.0, 'dlat':1.0, 'dlon':2.0, 'order':'separate'},
    spatial_axes := ['lat','lon']) WHERE 12 > latitude AND 10 < latitude;
----
3

query I
SELECT count(*) FROM read_om(
    '__WORKING_DIRECTORY__/test/data/raw.om',
    dimensions := map(['value'], [['lat','lon']]),
    grid := {'nx':3, 'ny':2, 'lat0':10.0, 'lon0':100.0, 'dlat':1.0, 'dlon':2.0, 'order':'separate'},
    spatial_axes := ['lat','lon']) WHERE latitude BETWEEN 11 AND 11 AND longitude BETWEEN 102 AND 104;
----
2

query I
SELECT count(*) FROM read_om(
    '__WORKING_DIRECTORY__/test/data/raw.om',
    dimensions := map(['value'], [['lat','lon']]),
    grid := {'nx':3, 'ny':2, 'lat0':10.0, 'lon0':100.0, 'dlat':1.0, 'dlon':2.0, 'order':'separate'},
    spatial_axes := ['lat','lon'])
WHERE latitude >= nextafter(10.0, 11.0);
----
3

query I
SELECT count(*) FROM read_om(
    '__WORKING_DIRECTORY__/test/data/raw.om',
    dimensions := map(['value'], [['lat','lon']]),
    grid := {'nx':3, 'ny':2, 'lat0':10.0, 'lon0':100.0, 'dlat':1.0, 'dlon':2.0, 'order':'separate'},
    spatial_axes := ['lat','lon']) WHERE latitude > 11 AND latitude < 10;
----
0

query I
SELECT count(*) FROM read_om(
    '__WORKING_DIRECTORY__/test/data/raw.om',
    dimensions := map(['value'], [['lat','lon']]),
    grid := {'nx':3, 'ny':2, 'lat0':10.0, 'lon0':100.0, 'dlat':1.0, 'dlon':2.0, 'order':'separate'},
    spatial_axes := ['lat','lon']) WHERE FALSE;
----
0

# Reverse axes cross the longitude seam without dropping source positions.
query I
SELECT count(*) FROM read_om(
    '__WORKING_DIRECTORY__/test/data/raw.om',
    dimensions := map(['value'], [['lat','lon']]),
    grid := {'nx':3, 'ny':2, 'lat0':10.0, 'lon0':181.0, 'dlat':-1.0, 'dlon':-1.0, 'order':'separate'},
    spatial_axes := ['lat','lon']) WHERE longitude = 179;
----
2

query I
SELECT count(*) FROM read_om(
    '__WORKING_DIRECTORY__/test/data/raw.om',
    dimensions := map(['value'], [['lat','lon']]),
    grid := {'nx':3, 'ny':2, 'lat0':10.0, 'lon0':179.0, 'dlat':1.0, 'dlon':1.0, 'order':'separate'},
    spatial_axes := ['lat','lon']) WHERE longitude >= 179 OR longitude < -179;
----
4

query III
SELECT min(latitude), max(longitude), count(*) FROM read_om(
    '__WORKING_DIRECTORY__/test/data/raw.om',
    dimensions := map(['value'], [['lat','lon']]),
    grid := {'nx':3, 'ny':2, 'lat0':10.0, 'lon0':100.0, 'dlat':1.0, 'dlon':2.0, 'order':'separate'},
    spatial_axes := ['lat','lon']) WHERE latitude > 10;
----
11	104	3

query I
SELECT count(*) FROM read_om(
    '__WORKING_DIRECTORY__/test/data/spatial_flat.om',
    dimensions := map(['value'], [['sample','point']]),
    grid := {'nx':3, 'ny':2, 'lat0':10.0, 'lon0':100.0, 'dlat':1.0, 'dlon':2.0, 'order':'lon_fastest'},
    spatial_axes := ['point']) WHERE latitude = 10 AND longitude = 102;
----
2
