# name: test/sql/spatial_pushdown.test
# description: Validate exact spatial predicate semantics and safe candidate selection
# group: [duckomo]

require skip_reload

require allow_unsigned_extensions

statement ok
LOAD '__BUILD_DIRECTORY__/extension/duckomo/duckomo.duckdb_extension';

query I
SELECT count(*) FROM read_om(
    '__WORKING_DIRECTORY__/test/data/raw.om',
    dimensions := map(['value'], [['lat','lon']]),
    grid := {'nx':3, 'ny':2, 'lat0':10.0, 'lon0':100.0, 'dlat':1.0, 'dlon':2.0, 'order':'separate'},
    spatial_axes := ['lat','lon']) WHERE lat = 11;
----
3

query I
SELECT count(*) FROM read_om(
    '__WORKING_DIRECTORY__/test/data/raw.om',
    dimensions := map(['value'], [['lat','lon']]),
    grid := {'nx':3, 'ny':2, 'lat0':10.0, 'lon0':100.0, 'dlat':1.0, 'dlon':2.0, 'order':'separate'},
    spatial_axes := ['lat','lon']) WHERE 11 <= lat AND lon < 104;
----
2

query I
SELECT count(*) FROM read_om(
    '__WORKING_DIRECTORY__/test/data/raw.om',
    dimensions := map(['value'], [['lat','lon']]),
    grid := {'nx':3, 'ny':2, 'lat0':10.0, 'lon0':100.0, 'dlat':1.0, 'dlon':2.0, 'order':'separate'},
    spatial_axes := ['lat','lon']) WHERE 12 > lat AND 10 < lat;
----
3

query I
SELECT count(*) FROM read_om(
    '__WORKING_DIRECTORY__/test/data/raw.om',
    dimensions := map(['value'], [['lat','lon']]),
    grid := {'nx':3, 'ny':2, 'lat0':10.0, 'lon0':100.0, 'dlat':1.0, 'dlon':2.0, 'order':'separate'},
    spatial_axes := ['lat','lon']) WHERE lat BETWEEN 11 AND 11 AND lon BETWEEN 102 AND 104;
----
2

query I
SELECT count(*) FROM read_om(
    '__WORKING_DIRECTORY__/test/data/raw.om',
    dimensions := map(['value'], [['lat','lon']]),
    grid := {'nx':3, 'ny':2, 'lat0':10.0, 'lon0':100.0, 'dlat':1.0, 'dlon':2.0, 'order':'separate'},
    spatial_axes := ['lat','lon'])
WHERE lat >= nextafter(10.0, 11.0);
----
3

query I
SELECT count(*) FROM read_om(
    '__WORKING_DIRECTORY__/test/data/raw.om',
    dimensions := map(['value'], [['lat','lon']]),
    grid := {'nx':3, 'ny':2, 'lat0':10.0, 'lon0':100.0, 'dlat':1.0, 'dlon':2.0, 'order':'separate'},
    spatial_axes := ['lat','lon']) WHERE lat > 11 AND lat < 10;
----
0

query I
SELECT count(*) FROM read_om(
    '__WORKING_DIRECTORY__/test/data/raw.om',
    dimensions := map(['value'], [['lat','lon']]),
    grid := {'nx':3, 'ny':2, 'lat0':10.0, 'lon0':100.0, 'dlat':1.0, 'dlon':2.0, 'order':'separate'},
    spatial_axes := ['lat','lon']) WHERE FALSE;
----
0

# Reverse axes cross the lon seam without dropping source positions.
query I
SELECT count(*) FROM read_om(
    '__WORKING_DIRECTORY__/test/data/raw.om',
    dimensions := map(['value'], [['lat','lon']]),
    grid := {'nx':3, 'ny':2, 'lat0':10.0, 'lon0':181.0, 'dlat':-1.0, 'dlon':-1.0, 'order':'separate'},
    spatial_axes := ['lat','lon']) WHERE lon = 179;
----
2

query I
SELECT count(*) FROM read_om(
    '__WORKING_DIRECTORY__/test/data/raw.om',
    dimensions := map(['value'], [['lat','lon']]),
    grid := {'nx':3, 'ny':2, 'lat0':10.0, 'lon0':179.0, 'dlat':1.0, 'dlon':1.0, 'order':'separate'},
    spatial_axes := ['lat','lon']) WHERE lon >= 179 OR lon < -179;
----
4

query I
SELECT count(*) FROM duckomo_last_scan_metrics()
WHERE metrics LIKE '%"selection_mode":"restricted"%'
  AND metrics NOT LIKE '%unsupported_or_expression%';
----
1

query III
SELECT min(lat), max(lon), count(*) FROM read_om(
    '__WORKING_DIRECTORY__/test/data/raw.om',
    dimensions := map(['value'], [['lat','lon']]),
    grid := {'nx':3, 'ny':2, 'lat0':10.0, 'lon0':100.0, 'dlat':1.0, 'dlon':2.0, 'order':'separate'},
    spatial_axes := ['lat','lon']) WHERE lat > 10;
----
11	104	3

query I
SELECT count(*) FROM read_om(
    '__WORKING_DIRECTORY__/test/data/spatial_flat.om',
    dimensions := map(['value'], [['sample','point']]),
    grid := {'nx':3, 'ny':2, 'lat0':10.0, 'lon0':100.0, 'dlat':1.0, 'dlon':2.0, 'order':'lon_fastest'},
    spatial_axes := ['point']) WHERE lat = 10 AND lon = 102;
----
2
