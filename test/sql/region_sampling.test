small-separate/humidity FLOAT
small-separate/temperature FLOAT

# Nearest schema appends sampling between region_id and optional om_source.
query T
SELECT column_name || ' ' || column_type
FROM (DESCRIBE SELECT * FROM read_om_regions(
    '__WORKING_DIRECTORY__/test/data/sampling/small-separate.om',
    regions := [{'id':'Gap','wkb':ST_AsWKB(ST_GeomFromText(
        'POLYGON((0.1 0.1,0.2 0.1,0.2 0.2,0.1 0.2,0.1 0.1))'))}],
    region_crs := 'grid_lonlat', dimensions := ['member','time','level','lat','lon'],
    grid := getvariable('nearest_grid'), spatial_axes := ['lat','lon'],
    axes := getvariable('nearest_axes'), method := 'nearest', include_source := true))
WHERE column_name IN ('region_id','sampling','om_source')
ORDER BY CASE column_name WHEN 'region_id' THEN 1 WHEN 'sampling' THEN 2 ELSE 3 END;
----
region_id VARCHAR
sampling STRUCT("method" VARCHAR, algorithm VARCHAR, representative VARCHAR, spatial_version VARCHAR, grid_id VARCHAR, layout_id VARCHAR, distance_model VARCHAR, earth_radius_m DOUBLE, status VARCHAR, source_lon DOUBLE, source_lat DOUBLE, source_point_index UBIGINT, distance_m DOUBLE, axis_indices UBIGINT[], variables MAP(VARCHAR, STRUCT(status VARCHAR, source_count UBIGINT, valid_source_count UBIGINT)))
om_source STRUCT(object_id VARCHAR, object_version VARCHAR, version_strength VARCHAR, content_verified BOOLEAN, grid_id VARCHAR, layout_id VARCHAR, logical_index UBIGINT, point_index UBIGINT, parent_point_index UBIGINT, axis_indices UBIGINT[])

# EMPTY and out-of-domain polygons retain rows with geometry-specific statuses.
query TIIIII
SELECT region_id, count(*), min(sampling.status), max(sampling.status),
       count(sampling.source_point_index), count("small-separate/temperature")
FROM read_om_regions(
    '__WORKING_DIRECTORY__/test/data/sampling/small-separate.om',
    regions := getvariable('nearest_regions'), region_crs := 'grid_lonlat',
    dimensions := ['member','time','level','lat','lon'],
    grid := getvariable('nearest_grid'), spatial_axes := ['lat','lon'],
    axes := getvariable('nearest_axes'), method := 'nearest')
GROUP BY region_id ORDER BY region_id;
----
Empty	12	empty_geometry	empty_geometry	0	0
Gap	12	ok	ok	12	12
Outside	12	outside_domain	outside_domain	0	0

# Full per-variable map and candidate/source/target NULL semantics are distinct:
# outside_domain has a target but no candidate; EMPTY has neither.
query T
SELECT region_id || ':' || sampling.status || ':' ||
       sampling.variables['small-separate/temperature'].status || ':' ||
       sampling.variables['small-separate/temperature'].source_count::VARCHAR || ':' ||
       sampling.variables['small-separate/temperature'].valid_source_count::VARCHAR || ':' ||
       sampling.variables['small-separate/humidity'].status || ':' ||
       sampling.variables['small-separate/humidity'].source_count::VARCHAR || ':' ||
       sampling.variables['small-separate/humidity'].valid_source_count::VARCHAR || ':' ||
       (lat IS NULL)::VARCHAR || ':' || (lon IS NULL)::VARCHAR || ':' ||
       (sampling.source_point_index IS NULL)::VARCHAR || ':' ||
       (sampling.source_lon IS NULL)::VARCHAR || ':' ||
       (sampling.source_lat IS NULL)::VARCHAR || ':' ||
       (sampling.distance_m IS NULL)::VARCHAR || ':' || (om_source IS NULL)::VARCHAR
FROM read_om_regions(
    '__WORKING_DIRECTORY__/test/data/sampling/small-separate.om',
    regions := getvariable('nearest_regions'), region_crs := 'grid_lonlat',
    dimensions := ['member','time','level','lat','lon'], grid := getvariable('nearest_grid'),
    spatial_axes := ['lat','lon'], axes := getvariable('nearest_axes'),
    method := 'nearest', include_source := true)
WHERE sampling.axis_indices = [1,2,1] AND region_id IN ('Empty','Outside')
ORDER BY region_id;
----
Empty:empty_geometry:empty_geometry:0:0:empty_geometry:0:0:true:true:true:true:true:true:true
Outside:outside_domain:outside_domain:0:0:outside_domain:0:0:false:false:true:true:true:true:true

