# A semantic-axis predicate with no matching source positions produces an exact
# empty result without losing the valid query's bound nearest schema.
query I
SELECT count(*) FROM read_om_regions(
    '__WORKING_DIRECTORY__/test/data/sampling/small-separate.om',
    regions := [{'id':'Gap','wkb':ST_AsWKB(ST_GeomFromText(
        'POLYGON((0.1 0.1,0.2 0.1,0.2 0.2,0.1 0.2,0.1 0.1))'))}],
    region_crs := 'grid_lonlat', dimensions := ['member','time','level','lat','lon'],
    grid := getvariable('nearest_grid'), spatial_axes := ['lat','lon'],
    axes := getvariable('nearest_axes'), method := 'nearest')
WHERE member = 999;
----
0

# The geometry adapter accepts a valid disconnected MultiPolygon as one whole-region
# representative target and keeps exactly one row per non-spatial axis tuple.
query T
SELECT count(*)::VARCHAR || '/' || first(sampling.status) || '/' ||
       count(DISTINCT sampling.source_point_index)::VARCHAR
FROM read_om_regions(
    '__WORKING_DIRECTORY__/test/data/sampling/small-separate.om',
    regions := [{'id':'Multi','wkb':ST_AsWKB(ST_GeomFromText(
        'MULTIPOLYGON(((-2 -2,-1 -2,-1 -1,-2 -1,-2 -2)),((1 1,2 1,2 2,1 2,1 1)))'))}],
    region_crs := 'grid_lonlat', dimensions := ['member','time','level','lat','lon'],
    grid := getvariable('nearest_grid'), spatial_axes := ['lat','lon'],
    axes := getvariable('nearest_axes'), method := 'nearest');
----
12/ok/1

