# Rebinding a prepared nearest scan reads the updated variable-backed region snapshot.
statement ok
SET VARIABLE nearest_rebind_regions = [{'id':'Gap','wkb':ST_AsWKB(ST_GeomFromText(
    'POLYGON((0.1 0.1,0.2 0.1,0.2 0.2,0.1 0.2,0.1 0.1))'))}];

statement ok
PREPARE nearest_rebind AS SELECT region_id || ':' || min(sampling.status) || ':' ||
       coalesce(min(sampling.source_point_index)::VARCHAR, 'NULL')
FROM read_om_regions(
    '__WORKING_DIRECTORY__/test/data/sampling/small-separate.om',
    regions := getvariable('nearest_rebind_regions'), region_crs := 'grid_lonlat',
    dimensions := ['member','time','level','lat','lon'], grid := getvariable('nearest_grid'),
    spatial_axes := ['lat','lon'], axes := getvariable('nearest_axes'), method := 'nearest')
GROUP BY region_id;

query T
EXECUTE nearest_rebind;
----
Gap:ok:12

statement ok
SET VARIABLE nearest_rebind_regions = [{'id':'Outside','wkb':ST_AsWKB(ST_GeomFromText(
    'POLYGON((10 10,11 10,11 11,10 11,10 10))'))}];

query T
EXECUTE nearest_rebind;
----
Outside:outside_domain:NULL

statement ok
DEALLOCATE nearest_rebind;

# Switching methods changes the schema; the descriptor is freshly bound for each method.
query T
SELECT column_name || ':' || column_type
FROM (DESCRIBE SELECT * FROM read_om_regions(
    '__WORKING_DIRECTORY__/test/data/sampling/small-separate.om',
    regions := getvariable('nearest_rebind_regions'), region_crs := 'grid_lonlat',
    dimensions := ['member','time','level','lat','lon'], grid := getvariable('nearest_grid'),
    spatial_axes := ['lat','lon'], axes := getvariable('nearest_axes'), method := 'nearest'))
WHERE column_name IN ('region_id','sampling');
----
region_id:VARCHAR
sampling:STRUCT("method" VARCHAR, algorithm VARCHAR, representative VARCHAR, spatial_version VARCHAR, grid_id VARCHAR, layout_id VARCHAR, distance_model VARCHAR, earth_radius_m DOUBLE, status VARCHAR, source_lon DOUBLE, source_lat DOUBLE, source_point_index UBIGINT, distance_m DOUBLE, axis_indices UBIGINT[], variables MAP(VARCHAR, STRUCT(status VARCHAR, source_count UBIGINT, valid_source_count UBIGINT)))

query T
SELECT column_name || ':' || column_type
FROM (DESCRIBE SELECT * FROM read_om_regions(
    '__WORKING_DIRECTORY__/test/data/sampling/small-separate.om',
    regions := getvariable('nearest_rebind_regions'), region_crs := 'grid_lonlat',
    dimensions := ['member','time','level','lat','lon'], grid := getvariable('nearest_grid'),
    spatial_axes := ['lat','lon'], axes := getvariable('nearest_axes'), method := 'points'))
WHERE column_name IN ('region_id','sampling');
----
region_id:VARCHAR
