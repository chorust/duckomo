# name: test/sql/region_sampling.test
# description: Validate nearest region sampling results, statuses, options, and layouts
# group: [duckomo]

require skip_reload

require allow_unsigned_extensions

require-env DUCKOMO_SPATIAL_EXTENSION

statement ok
LOAD '__BUILD_DIRECTORY__/extension/duckomo/duckomo.duckdb_extension';

statement ok
LOAD '${DUCKOMO_SPATIAL_EXTENSION}';

# Leaf projections preserve nested field types; native and full suite checks
# verify value read dependencies from exact scan metrics.
query TTT
SELECT count(*)::VARCHAR, first(typeof(sampling.status)), first(sampling.status)
FROM read_om_regions(
    '__WORKING_DIRECTORY__/test/data/sampling/small-separate.om',
    regions := [{'id':'Gap','wkb':ST_AsWKB(ST_GeomFromText(
        'POLYGON((0.1 0.1,0.2 0.1,0.2 0.2,0.1 0.2,0.1 0.1))'))}],
    region_crs := 'grid_lonlat', dimensions := ['member','time','level','lat','lon'],
    grid := {'nx':5,'ny':5,'lat0':-2.0,'lon0':-2.0,'dlat':1.0,'dlon':1.0,'order':'separate'},
    spatial_axes := ['lat','lon'], method := 'nearest');
----
12	VARCHAR	ok

query TTT
SELECT count(*)::VARCHAR, first(typeof(sampling.source_point_index)), first(sampling.source_point_index)::VARCHAR
FROM read_om_regions(
    '__WORKING_DIRECTORY__/test/data/sampling/small-separate.om',
    regions := [{'id':'Gap','wkb':ST_AsWKB(ST_GeomFromText(
        'POLYGON((0.1 0.1,0.2 0.1,0.2 0.2,0.1 0.2,0.1 0.1))'))}],
    region_crs := 'grid_lonlat', dimensions := ['member','time','level','lat','lon'],
    grid := {'nx':5,'ny':5,'lat0':-2.0,'lon0':-2.0,'dlat':1.0,'dlon':1.0,'order':'separate'},
    spatial_axes := ['lat','lon'], method := 'nearest');
----
12	UBIGINT	12

statement ok
SET VARIABLE nearest_grid = {'nx':5,'ny':5,'lat0':-2.0,'lon0':-2.0,
                             'dlat':1.0,'dlon':1.0,'order':'separate'};

statement ok
SET VARIABLE nearest_axes = {
    'time':{'axis':'time','start':TIMESTAMP '2026-01-01 00:00:00','step':INTERVAL '1 hour'},
    'member':{'axis':'member','values':[0::BIGINT,1::BIGINT]},
    'level':{'axis':'level','values':[100::BIGINT,200::BIGINT],'kind':'pressure','unit':'hPa'}
};

statement ok
SET VARIABLE nearest_unmapped_axes = {
    'member':{'axis':'member','values':[10::BIGINT,20::BIGINT]}
};

statement ok
SET VARIABLE nearest_regions = [
    {'id':'Gap','wkb':ST_AsWKB(ST_GeomFromText('POLYGON((0.1 0.1,0.2 0.1,0.2 0.2,0.1 0.2,0.1 0.1))'))},
    {'id':'Outside','wkb':ST_AsWKB(ST_GeomFromText('POLYGON((10 10,11 10,11 11,10 11,10 10))'))},
    {'id':'Empty','wkb':ST_AsWKB(ST_GeomFromText('POLYGON EMPTY'))}
];

# Geometry-only leaves and COUNT preserve all rows while reading no value bytes.
query I
SELECT count(*) FROM read_om_regions(
    '__WORKING_DIRECTORY__/test/data/sampling/small-separate.om',
    regions := getvariable('nearest_regions'), region_crs := 'grid_lonlat',
    dimensions := ['member','time','level','lat','lon'], grid := getvariable('nearest_grid'),
    spatial_axes := ['lat','lon'], axes := getvariable('nearest_axes'), method := 'nearest');
