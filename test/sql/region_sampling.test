# No new singular or general computation table function is registered, and the only
# factory signatures keep the existing read_om/raw/grid-info parameters unchanged.
query I
WITH expected(function_name, parameters, parameter_types) AS (
    VALUES
        ('read_om_raw', ['col0']::VARCHAR[], ['VARCHAR']::VARCHAR[]),
        ('read_om', ['col0','variable','axes','valid_times','include_source','domain','grid','spatial_axes','dimensions'],
                    ['VARCHAR','VARCHAR','ANY','TIMESTAMP[]','BOOLEAN','VARCHAR','ANY','VARCHAR[]','ANY']),
        ('om_grid_info', ['col0','variable','axes','valid_times','domain','grid','spatial_axes','dimensions'],
                        ['VARCHAR','VARCHAR','ANY','TIMESTAMP[]','VARCHAR','ANY','VARCHAR[]','ANY']),
        ('read_om_regions', ['col0','variable','axes','include_source','domain','grid','spatial_axes','dimensions',
                             'valid_times','out_of_bounds','max_distance_m','method','region_crs','regions'],
                            ['VARCHAR','VARCHAR','ANY','BOOLEAN','VARCHAR','ANY','VARCHAR[]','ANY',
                             'TIMESTAMP[]','ANY','ANY','ANY','ANY','ANY'])
), actual AS (
    SELECT function_name, parameters, parameter_types
    FROM duckdb_functions()
    WHERE function_name IN ('read_om_raw','read_om','read_om_regions','om_grid_info')
)
SELECT count(*) FROM expected e LEFT JOIN actual a USING (function_name)
WHERE a.function_name IS NULL OR a.parameters <> e.parameters OR a.parameter_types <> e.parameter_types;
----
0

query I
SELECT count(*) FROM duckdb_functions()
WHERE function_name IN ('read_om_region','sample_om_regions','read_om_samples');
----
0

# Nearest adds only its own STRUCT column; original variable names and FLOAT types persist.
query T
SELECT column_name || ' ' || column_type
FROM (DESCRIBE SELECT * FROM read_om_regions(
    '__WORKING_DIRECTORY__/test/data/sampling/small-separate.om',
    regions := [{'id':'Gap','wkb':ST_AsWKB(ST_GeomFromText(
        'POLYGON((0.1 0.1,0.2 0.1,0.2 0.2,0.1 0.2,0.1 0.1))'))}],
    region_crs := 'grid_lonlat', dimensions := ['member','time','level','lat','lon'],
    grid := getvariable('nearest_grid'), spatial_axes := ['lat','lon'],
    axes := getvariable('nearest_axes'), method := 'nearest'))
WHERE column_name IN ('small-separate/temperature','small-separate/humidity','sampling')
ORDER BY CASE column_name WHEN 'small-separate/humidity' THEN 1 WHEN 'small-separate/temperature' THEN 2 ELSE 3 END;
----
small-separate/humidity FLOAT
small-separate/temperature FLOAT
sampling STRUCT("method" VARCHAR, algorithm VARCHAR, representative VARCHAR, spatial_version VARCHAR, grid_id VARCHAR, layout_id VARCHAR, distance_model VARCHAR, earth_radius_m DOUBLE, status VARCHAR, source_lon DOUBLE, source_lat DOUBLE, source_point_index UBIGINT, distance_m DOUBLE, axis_indices UBIGINT[], variables MAP(VARCHAR, STRUCT(status VARCHAR, source_count UBIGINT, valid_source_count UBIGINT)))

query T
