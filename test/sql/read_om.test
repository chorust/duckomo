# name: test/sql/read_om.test
# description: Validate aligned multi-variable OM schemas, rows, and axis declarations
# group: [duckomo]

require skip_reload

require allow_unsigned_extensions

statement ok
LOAD '__BUILD_DIRECTORY__/extension/duckomo/duckomo.duckdb_extension';

# Remote input stays fail-closed without the paired range-session provider, and
# signed URL query parameters are never echoed in the error.
statement error
SELECT * FROM read_om('https://example.invalid/file.om?X-Amz-Signature=must-not-appear');
----
<REGEX>:(?i).*paired httpfs range-session extension.*

# A single root array has the stable value column and does not need dimensions.
query T
SELECT column_name || ' ' || column_type
FROM (DESCRIBE SELECT * FROM read_om('__WORKING_DIRECTORY__/test/data/raw.om'));
----
value FLOAT

# Real-world-style PFOR arrays retain their scalar attributes. Matching
# coordinates metadata allows safe alignment without an explicit dimensions map.
query T
SELECT column_name || ' ' || column_type
FROM (DESCRIBE SELECT * FROM read_om('__WORKING_DIRECTORY__/test/data/pfor_attributes.om'));
----
humidity FLOAT
temperature FLOAT

query RR
SELECT humidity, temperature
FROM read_om('__WORKING_DIRECTORY__/test/data/pfor_attributes.om')
ORDER BY humidity;
----
10.000000	1.250000
20.000000	NULL
30.000000	-2.500000
40.000000	3.500000
50.000000	4.250000
60.000000	5.000000

statement error
SELECT * FROM read_om(
    '__WORKING_DIRECTORY__/test/data/pfor_attributes.om',
    dimensions := map(['humidity', 'temperature'], [['x', 'y'], ['x', 'y']])
);
----
<REGEX>:(?i).*(coordinates|axis names|dimensions).*

query R
SELECT value FROM read_om('__WORKING_DIRECTORY__/test/data/raw.om') ORDER BY value;
----
0.000000
1.000000
2.000000
3.000000
4.000000
5.000000

# Explicit NULL has the same single-array behavior as an omitted dimensions map.
query I
SELECT count(*) FROM read_om('__WORKING_DIRECTORY__/test/data/raw.om', dimensions := NULL);
----
6

# The generic metadata-driven scanner preserves the raw special-value policy.
query IIIII
SELECT count(*) FILTER (WHERE value IS NULL),
       count(*) FILTER (WHERE isinf(value) AND value > 0),
       count(*) FILTER (WHERE isinf(value) AND value < 0),
       count(*) FILTER (WHERE value = 0 AND NOT signbit(value)),
       count(*) FILTER (WHERE value = 0 AND signbit(value))
FROM read_om('__WORKING_DIRECTORY__/test/data/special.om');
----
1	1	1	1	1

# Multi-variable columns use canonical paths in UTF-8 byte order.
query T
SELECT column_name || ' ' || column_type
FROM (DESCRIBE SELECT * FROM read_om(
    '__WORKING_DIRECTORY__/test/data/multi.om',
    dimensions := map(
        ['humidity', 'temperature'],
        [['row', 'column'], ['row', 'column']]
    )
))
ORDER BY column_name;
----
humidity FLOAT
temperature FLOAT

# Both variables on each row refer to the same flattened index tuple.
query RR
SELECT "humidity", "temperature"
FROM read_om(
    '__WORKING_DIRECTORY__/test/data/multi.om',
    dimensions := map(
        ['humidity', 'temperature'],
        [['row', 'column'], ['row', 'column']]
    )
)
ORDER BY "humidity";
----
100.000000	0.000000
101.000000	1.000000
102.000000	2.000000
103.000000	3.000000
104.000000	4.000000
105.000000	5.000000

# Repeating the same full scan gives the same ordered values.
query RR
SELECT "humidity", "temperature"
FROM read_om(
    '__WORKING_DIRECTORY__/test/data/multi.om',
    dimensions := map(
        ['humidity', 'temperature'],
        [['row', 'column'], ['row', 'column']]
    )
)
ORDER BY "humidity";
----
100.000000	0.000000
101.000000	1.000000
102.000000	2.000000
103.000000	3.000000
104.000000	4.000000
105.000000	5.000000

# Nested variables with repeated leaf names retain distinct canonical paths;
# names containing slash and percent are escaped. Columns sort by full path.
query T
SELECT column_name || ' ' || column_type
FROM (DESCRIBE SELECT * FROM read_om(
    '__WORKING_DIRECTORY__/test/data/nested.om',
    dimensions := map(
        ['layer_a/value', 'layer_b/temperature', 'layer_b/value', 'temperature', 'weird%2Fname%25/value'],
        [['row', 'column'], ['row', 'column'], ['row', 'column'], ['row', 'column'], ['row', 'column']]
    )
))
ORDER BY column_name;
----
layer_a/value FLOAT
layer_b/temperature FLOAT
layer_b/value FLOAT
temperature FLOAT
weird%2Fname%25/value FLOAT

# Full nested scans keep each variable aligned with the same six logical rows.
query RRRRR
SELECT "layer_a/value", "layer_b/temperature", "layer_b/value", "temperature",
       "weird%2Fname%25/value"
FROM read_om(
    '__WORKING_DIRECTORY__/test/data/nested.om',
    dimensions := map(
        ['layer_a/value', 'layer_b/temperature', 'layer_b/value', 'temperature', 'weird%2Fname%25/value'],
        [['row', 'column'], ['row', 'column'], ['row', 'column'], ['row', 'column'], ['row', 'column']]
    )
)
ORDER BY "temperature";
----
100.000000	200.000000	300.000000	0.000000	400.000000
101.000000	201.000000	301.000000	1.000000	401.000000
102.000000	202.000000	302.000000	2.000000	402.000000
103.000000	203.000000	303.000000	3.000000	403.000000
104.000000	204.000000	304.000000	4.000000	404.000000
105.000000	205.000000	305.000000	5.000000	405.000000

# Exact coverage is required: a missing key and an unknown replacement key
# must both fail during binding.
statement error
SELECT * FROM read_om(
    '__WORKING_DIRECTORY__/test/data/multi.om',
    dimensions := map(['temperature'], [['row', 'column']])
);
----
<REGEX>:(?i).*(dimensions|keys|humidity|cover).*

statement error
SELECT * FROM read_om(
    '__WORKING_DIRECTORY__/test/data/multi.om',
    dimensions := map(['/other', 'temperature'], [['row', 'column'], ['row', 'column']])
);
----
<REGEX>:(?i).*(dimensions|unknown|array path|other).*

# The axis list must have one nonempty, non-NULL, unique name per rank.
statement error
SELECT * FROM read_om(
    '__WORKING_DIRECTORY__/test/data/multi.om',
    dimensions := map(
        ['humidity', 'temperature'],
        [['row'], ['row', 'column']]
    )
);
----
<REGEX>:(?i).*(dimensions|axis count|rank 2).*

statement error
SELECT * FROM read_om(
    '__WORKING_DIRECTORY__/test/data/multi.om',
    dimensions := map(
        ['humidity', 'temperature'],
        [['row', 'row'], ['row', 'column']]
    )
);
----
<REGEX>:(?i).*(dimensions|duplicate axis).*

statement error
SELECT * FROM read_om(
    '__WORKING_DIRECTORY__/test/data/multi.om',
    dimensions := map(
        ['humidity', 'temperature'],
        [['row', ''], ['row', 'column']]
    )
);
----
<REGEX>:(?i).*(dimensions|empty).*

statement error
SELECT * FROM read_om(
    '__WORKING_DIRECTORY__/test/data/multi.om',
    dimensions := map(
        ['humidity', 'temperature'],
        [['row', NULL], ['row', 'column']]
    )
);
----
<REGEX>:(?i).*(dimensions|NULL).*

statement error
SELECT * FROM read_om(
    '__WORKING_DIRECTORY__/test/data/multi.om',
    dimensions := map(
        ['humidity', 'temperature'],
        [NULL, ['row', 'column']]
    )
);
----
<REGEX>:(?i).*(dimensions|NULL|axis list).*

# A scalar argument is not a MAP(VARCHAR, VARCHAR[]) dimensions declaration.
statement error
SELECT * FROM read_om('__WORKING_DIRECTORY__/test/data/raw.om', dimensions := 42);
----
<REGEX>:(?i).*(dimensions|MAP|VARCHAR|argument|parameter|function).*

# Same shapes do not prove alignment when declared ordered axis identities differ.
statement error
SELECT * FROM read_om(
    '__WORKING_DIRECTORY__/test/data/multi.om',
    dimensions := map(
        ['humidity', 'temperature'],
        [['row', 'other'], ['row', 'column']]
    )
);
----
<REGEX>:(?i).*(axis order|dimensions|humidity).*

statement error
SELECT * FROM read_om(
    '__WORKING_DIRECTORY__/test/data/negative/shape_mismatch.om',
    dimensions := map(
        ['humidity', 'temperature'],
        [['row', 'column'], ['row', 'column']]
    )
);
----
<REGEX>:(?i).*(shape|dimension|align|identical).*

# A multi-variable file cannot omit the explicit axis mapping.
statement error
SELECT * FROM read_om('__WORKING_DIRECTORY__/test/data/multi.om');
----
<REGEX>:(?i).*(dimensions|multiple arrays|axis).*

# Unsupported OM versions, array types, compression, and empty dimensions fail
# before any rows are returned.
statement error
SELECT * FROM read_om(
    '__WORKING_DIRECTORY__/test/data/negative/unsupported_version.om',
    dimensions := map(
        ['humidity', 'temperature'],
        [['row', 'column'], ['row', 'column']]
    )
);
----
<REGEX>:(?i).*(unsupported|version).*

statement error
SELECT * FROM read_om(
    '__WORKING_DIRECTORY__/test/data/negative/unsupported_type.om',
    dimensions := map(
        ['humidity', 'temperature'],
        [['row', 'column'], ['row', 'column']]
    )
);
----
<REGEX>:(?i).*(Float32|data type|unsupported|temperature).*

statement error
SELECT * FROM read_om(
    '__WORKING_DIRECTORY__/test/data/negative/unsupported_compression.om',
    dimensions := map(
        ['humidity', 'temperature'],
        [['row', 'column'], ['row', 'column']]
    )
);
----
<REGEX>:(?i).*(compression|FPX|unsupported|temperature).*

statement error
SELECT * FROM read_om(
    '__WORKING_DIRECTORY__/test/data/negative/empty_array_zero_axis.om',
    dimensions := map(
        ['humidity', 'temperature'],
        [['row', 'column'], ['row', 'column']]
    )
);
----
<REGEX>:(?i).*(zero|empty|shape|dimension).*

# No synthetic coordinate columns are exposed; ordinary name binding reports
# requests for latitude, longitude, and time as absent columns.
statement error
SELECT latitude
FROM read_om(
    '__WORKING_DIRECTORY__/test/data/multi.om',
    dimensions := map(
        ['humidity', 'temperature'],
        [['row', 'column'], ['row', 'column']]
    )
);
----
<REGEX>:(?i).*(latitude|referenced column|not found).*

statement error
SELECT longitude, time
FROM read_om(
    '__WORKING_DIRECTORY__/test/data/multi.om',
    dimensions := map(
        ['humidity', 'temperature'],
        [['row', 'column'], ['row', 'column']]
    )
);
----
<REGEX>:(?i).*(longitude|time|referenced column|not found).*
