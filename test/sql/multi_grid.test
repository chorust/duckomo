# The legacy seven-field regular grid keeps the original coordinate columns
# and row-major value positions after version=1 definitions are introduced.
query RRR
SELECT value, latitude, longitude
FROM read_om(
    '__WORKING_DIRECTORY__/test/data/raw.om',
    dimensions := map(['value'], [['row', 'column']]),
    grid := {'nx': 3, 'ny': 2, 'lat0': 0.0, 'lon0': 0.0,
             'dlat': 1.0, 'dlon': 1.0, 'order': 'separate'},
    spatial_axes := ['row', 'column'])
ORDER BY value;
----
0.000000	0.000000	0.000000
1.000000	0.000000	1.000000
2.000000	0.000000	2.000000
3.000000	1.000000	0.000000
4.000000	1.000000	1.000000
5.000000	1.000000	2.000000

# Version-one definitions evaluate copied spatial predicates on native source
# positions while keeping the original SQL filter for exact result semantics.
query RRR
SELECT value, latitude, longitude
FROM read_om(
    '__WORKING_DIRECTORY__/test/data/raw.om',
    dimensions := map(['value'], [['row', 'column']]),
    grid := {
        'version': 1,
        'type': 'rotated_latlon',
        'numeric_policy': 'float64_v1',
        'earth': {'model': 'sphere', 'radius_m': 6371229.0},
        'layout': {'nx': 3, 'ny': 2, 'order': 'separate'},
        'parameters': {
            'x0': 0.0, 'y0': 0.0, 'dx': 1.0, 'dy': 1.0,
            'north_pole_latitude': 90.0, 'north_pole_longitude': 0.0,
            'rotation': 0.0
        }
    },
    spatial_axes := ['row', 'column'])
WHERE longitude >= 1.5 OR longitude < 0.5
ORDER BY value;
----
0.000000	0.000000	0.000000
2.000000	0.000000	2.000000
3.000000	1.000000	0.000000
5.000000	1.000000	2.000000

query I
SELECT count(*) FROM duckomo_last_scan_metrics()
WHERE metrics LIKE '%"selection_mode":"restricted"%'
  AND metrics NOT LIKE '%unsafe_or_expression%';
----
1

# One unsafe branch widens the whole OR candidate set and remains a residual.
query I
SELECT count(*)
FROM read_om(
    '__WORKING_DIRECTORY__/test/data/raw.om',
    dimensions := map(['value'], [['row', 'column']]),
    grid := {
        'version': 1,
        'type': 'rotated_latlon',
        'numeric_policy': 'float64_v1',
        'earth': {'model': 'sphere', 'radius_m': 6371229.0},
        'layout': {'nx': 3, 'ny': 2, 'order': 'separate'},
        'parameters': {
            'x0': 0.0, 'y0': 0.0, 'dx': 1.0, 'dy': 1.0,
            'north_pole_latitude': 90.0, 'north_pole_longitude': 0.0,
            'rotation': 0.0
        }
    },
    spatial_axes := ['row', 'column'])
WHERE longitude >= 1 OR value = 0;
----
4

query I
SELECT count(*) FROM duckomo_last_scan_metrics()
WHERE metrics LIKE '%"selection_mode":"fallback"%'
  AND metrics LIKE '%unsafe_or_expression%';
----
1

