# name: test/sql/multi_grid.test
# description: Validate version=1 grid binding and native-position coordinates
# group: [duckomo]

require skip_reload

require allow_unsigned_extensions

statement ok
LOAD '__BUILD_DIRECTORY__/extension/duckomo/duckomo.duckdb_extension';

statement ok
LOAD '__BUILD_DIRECTORY__/extension/json/json.duckdb_extension';

# A rotated grid with its north pole at the geographic north pole is an
# identity mapping. The fixture has six row-major values in [row, column].
query RRR
SELECT value, latitude, longitude
FROM read_om(
    '__WORKING_DIRECTORY__/test/data/raw.om',
    dimensions := map(['value'], [['row', 'column']]),
    grid := {
        'version': 1,
        'type': 'rotated_latlon',
        'numeric_policy': 'float64_v1',
        'earth': {'model': 'sphere', 'radius_m': 6371229.0},
        'layout': {'nx': 3, 'ny': 2, 'order': 'separate'},
        'parameters': {
            'x0': 0.0, 'y0': 0.0, 'dx': 1.0, 'dy': 1.0,
            'north_pole_latitude': 90.0, 'north_pole_longitude': 0.0,
            'rotation': 0.0
        }
    },
    spatial_axes := ['row', 'column']
)
ORDER BY value;
----
0.000000	0.000000	0.000000
1.000000	0.000000	1.000000
2.000000	0.000000	2.000000
3.000000	1.000000	0.000000
4.000000	1.000000	1.000000
5.000000	1.000000	2.000000

# Source positions remain the original row-major positions and object identity
# is opaque; no content or version evidence is claimed for this fixture.
query IIIIIIIIIII
SELECT count(*), count(*) FILTER (WHERE om_source.version_strength = 'unverifiable'),
       count(*) FILTER (WHERE om_source.content_verified), min(om_source.logical_index),
       max(om_source.logical_index), min(om_source.point_index), max(om_source.point_index),
       count(*) FILTER (WHERE om_source.object_version IS NULL),
       count(*) FILTER (WHERE starts_with(om_source.object_id, 'sha256:')),
       count(*) FILTER (WHERE om_source.grid_id IS NOT NULL AND om_source.layout_id IS NOT NULL),
       count(*) FILTER (WHERE om_source.axis_indices[1] BETWEEN 0 AND 1 AND
                              om_source.axis_indices[2] BETWEEN 0 AND 2)
FROM read_om(
    '__WORKING_DIRECTORY__/test/data/raw.om',
    dimensions := map(['value'], [['row', 'column']]),
    grid := {
        'version': 1,
        'type': 'rotated_latlon',
        'numeric_policy': 'float64_v1',
        'earth': {'model': 'sphere', 'radius_m': 6371229.0},
        'layout': {'nx': 3, 'ny': 2, 'order': 'separate'},
        'parameters': {
            'x0': 0.0, 'y0': 0.0, 'dx': 1.0, 'dy': 1.0,
            'north_pole_latitude': 90.0, 'north_pole_longitude': 0.0,
            'rotation': 0.0
        }
    },
    spatial_axes := ['row', 'column'], include_source := true
);
----
6	6	0	0	5	0	5	6	6	6	6

statement error
SELECT * FROM read_om('__WORKING_DIRECTORY__/test/data/raw.om', include_source := NULL);
----
<REGEX>:(?i).*(include_source|BOOLEAN|grid or domain).*

