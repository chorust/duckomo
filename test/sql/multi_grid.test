statement ok
CREATE MACRO n160_explicit_grid() AS struct_pack(
    version := 1::BIGINT,
    type := 'reduced_gaussian',
    numeric_policy := 'openmeteo_f32_v1',
    earth := struct_pack(model := 'wgs84', semi_major_m := 6378137.0, inverse_flattening := 298.257223563),
    layout := struct_pack("order" := 'row_major'),
    parameters := struct_pack(
        n := 160::BIGINT,
        latitude_rule := 'openmeteo_approx_v1',
        rows := list_transform(range(0, 320), lambda index : struct_pack(
            latitude := list_extract(n160_row_latitudes(), index + 1),
            point_count := list_extract(n160_row_counts(), index + 1),
            longitude_origin := 0.0::DOUBLE,
            longitude_step := CAST(CAST(360.0 AS FLOAT) / CAST(list_extract(n160_row_counts(), index + 1) AS FLOAT) AS DOUBLE)
        )),
        subset_segments := NULL::STRUCT(parent_row BIGINT, parent_begin BIGINT, count BIGINT)[]
    )
);

# Both declarations use the same synthetic shape. Matching identity and layout
# tests the public explicit/domain binding contract, not producer coordinates.
query II
WITH domain_info AS (
    SELECT grid_id, layout::VARCHAR AS layout
    FROM om_grid_info(
        '__WORKING_DIRECTORY__/test/data/grids/gaussian-n160-identity.om',
        dimensions := map(['n160_identity/value'], [['point']]),
        domain := 'n160'
    )
), explicit_info AS (
    SELECT grid_id, layout::VARCHAR AS layout
    FROM om_grid_info(
        '__WORKING_DIRECTORY__/test/data/grids/gaussian-n160-identity.om',
        dimensions := map(['n160_identity/value'], [['point']]),
        grid := n160_explicit_grid(),
        spatial_axes := ['point']
    )
)
SELECT domain_info.grid_id = explicit_info.grid_id,
       domain_info.layout = explicit_info.layout
FROM domain_info CROSS JOIN explicit_info;
----
true	true
