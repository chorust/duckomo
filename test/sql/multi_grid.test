# Each closed grid family binds through the same version=1 interface. The
# synthetic arrays exercise separate, x-fastest, y-fastest, and row-major axes.
query III
SELECT count(*), count(*) FILTER (WHERE latitude IS NULL),
       count(*) FILTER (WHERE longitude IS NULL)
FROM read_om(
    '__WORKING_DIRECTORY__/test/data/grids/reverse.om',
    dimensions := map(['reverse/value'], [['latitude_axis', 'longitude_axis']]),
    grid := {
        'version': 1, 'type': 'rotated_latlon', 'numeric_policy': 'float64_v1',
        'earth': {'model': 'sphere', 'radius_m': 6371229.0},
        'layout': {'nx': 4, 'ny': 3, 'order': 'separate'},
        'parameters': {'x0': 0.0, 'y0': 0.0, 'dx': 1.0, 'dy': 1.0,
                       'north_pole_latitude': 90.0, 'north_pole_longitude': 0.0, 'rotation': 0.0}
    },
    spatial_axes := ['latitude_axis', 'longitude_axis']
);
----
12	0	0

# Gaussian region segments define local logical order independently of parent
# row/point positions.  Value decoding must use the object's local point offset.
query IIII
SELECT count(*)::INTEGER, sum("flattened_x_fastest/value")::INTEGER,
       min("flattened_x_fastest/value")::INTEGER, max("flattened_x_fastest/value")::INTEGER
FROM read_om(
    '__WORKING_DIRECTORY__/test/data/grids/x-fastest.om',
    dimensions := map(['flattened_x_fastest/value'], [['point']]),
    grid := {
        'version': 1, 'type': 'reduced_gaussian', 'numeric_policy': 'float64_v1',
        'earth': {'model': 'wgs84', 'semi_major_m': 6378137.0, 'inverse_flattening': 298.257223563},
        'layout': {'order': 'row_major'},
        'parameters': {
            'n': 1, 'latitude_rule': 'explicit_v1',
            'rows': [{'latitude': 60.0, 'point_count': 6, 'longitude_origin': 0.0, 'longitude_step': 60.0},
                     {'latitude': -60.0, 'point_count': 6, 'longitude_origin': 0.0, 'longitude_step': 60.0}],
            'subset_segments': [{'parent_row': 0, 'parent_begin': 3, 'count': 3},
                                {'parent_row': 1, 'parent_begin': 0, 'count': 6},
                                {'parent_row': 0, 'parent_begin': 0, 'count': 3}]
        }
    }, spatial_axes := ['point'])
WHERE longitude BETWEEN -70 AND 70;
----
6	708	2	202

