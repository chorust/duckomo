# name: test/sql/cache_metrics.test
# description: Validate session cache settings and per-scan v3 metrics publication
# group: [duckomo]

require skip_reload

require allow_unsigned_extensions

statement ok
LOAD '__BUILD_DIRECTORY__/extension/duckomo/duckomo.duckdb_extension';

statement error
SET duckomo_cache_enabled=false;
----
<REGEX>:(?i).*(unrecognized configuration parameter|does not exist).*

statement error
SET duckomo_cache_capacity=1024;
----
<REGEX>:(?i).*(unrecognized configuration parameter|does not exist).*

statement error
SELECT * FROM duckomo_clear_cache();
----
<REGEX>:(?i).*(unrecognized configuration parameter|does not exist).*

query I
SELECT count(*) FROM duckomo_last_scan_metrics();
----
0

query I
SELECT count(*) FROM read_om('__WORKING_DIRECTORY__/test/data/raw.om');
----
6

query I
SELECT count(*) FROM duckomo_last_scan_metrics();
----
1

query I
SELECT count(*) FROM duckomo_last_scan_metrics()
WHERE metrics LIKE '%"schema_version":3%'
  AND metrics LIKE '%"status":"success"%'
  AND metrics LIKE '%"scanner_rows":6%';
----
1

query I
SELECT count(*) FROM duckomo_last_scan_metrics()
WHERE metrics LIKE '%"schema_version":4%'
  AND metrics LIKE '%"legacy_v3":{"schema_version":3%'
  AND metrics LIKE '%"terminal_published":true%';
----
1

query I
SELECT count(*) FROM read_om('__WORKING_DIRECTORY__/test/data/raw.om')
WHERE concat('http', '://host/file.om?X-Amz-Signature=secret-token') IS NOT NULL;
----
6

query I
SELECT count(*) FROM duckomo_last_scan_metrics()
WHERE metrics LIKE '%"sql":"<redacted>"%'
  AND metrics NOT LIKE '%secret-token%';
----
1

query I
SELECT count(*) FROM (
  SELECT value FROM read_om('__WORKING_DIRECTORY__/test/data/dimensions_perf.om') LIMIT 1
);
----
1

query I
SELECT count(*) FROM duckomo_last_scan_metrics()
WHERE metrics LIKE '%"status":"success"%'
  AND metrics LIKE '%"scan_complete":false%';
----
1

query I
SELECT count(*) FROM duckomo_last_scan_metrics()
WHERE metrics LIKE '%"schema_version":4%'
  AND metrics LIKE '%"outcome":{"status":"success","scan_complete":false,"terminal_published":true%'
  AND metrics LIKE '%"exact_candidate_records":null%'
  AND metrics LIKE '%"count_complete":false%';
----
1

query I
SELECT count(*) FROM read_om('__WORKING_DIRECTORY__/test/data/raw.om') a,
                           read_om('__WORKING_DIRECTORY__/test/data/raw.om') b;
----
36

query I
SELECT CASE WHEN count(*) = 2 AND count(DISTINCT query_id) = 1 AND count(DISTINCT scan_id) = 2
                  AND min(scan_id) = 0 AND max(scan_id) = 1 THEN 1 ELSE 0 END
FROM duckomo_last_scan_metrics()
WHERE metrics LIKE '%"schema_version":3%';
----
1

statement error
SELECT * FROM read_om('__WORKING_DIRECTORY__/test/data/missing_dimensions.om');
----
<REGEX>:(?i).*could not open local OM file.*

query I
SELECT count(*) FROM duckomo_last_scan_metrics()
WHERE metrics LIKE '%"status":"failure"%';
----
1

query I
SELECT count(*) FROM duckomo_last_scan_metrics();
----
1

