# name: test/sql/region_sampling_spatial_dependency.test
# description: Ensure nearest sampling requires explicit matching spatial signatures while ordinary readers remain independent
# group: [duckomo]

require skip_reload

require allow_unsigned_extensions

statement ok
LOAD '__BUILD_DIRECTORY__/extension/duckomo/duckomo.duckdb_extension';

query I
SELECT count(*) FROM read_om_raw('__WORKING_DIRECTORY__/test/data/raw.om');
----
6

query I
SELECT count(*) FROM read_om(
    '__WORKING_DIRECTORY__/test/data/regions/regions.om',
    dimensions := ['member','time','lat','lon'],
    grid := {'nx':5,'ny':5,'lat0':20.0,'lon0':100.0,'dlat':1.0,'dlon':1.0,'order':'separate'},
    spatial_axes := ['lat','lon'],
    axes := {
        'time':{'axis':'time','start':TIMESTAMP '2026-01-01 00:00:00','step':INTERVAL '1 hour'},
        'member':{'axis':'member','values':[0::BIGINT,1::BIGINT]}});
----
150

# points keeps the historical exact spatial dependency without requiring nearest-only functions.
statement error
SELECT * FROM read_om_regions(
    '__WORKING_DIRECTORY__/test/data/regions/regions.om',
    regions := []::STRUCT(id VARCHAR,wkb BLOB)[], region_crs := 'grid_lonlat',
    dimensions := ['member','time','lat','lon'],
    grid := {'nx':5,'ny':5,'lat0':20.0,'lon0':100.0,'dlat':1.0,'dlon':1.0,'order':'separate'},
    spatial_axes := ['lat','lon'],
    axes := {
        'time':{'axis':'time','start':TIMESTAMP '2026-01-01 00:00:00','step':INTERVAL '1 hour'},
        'member':{'axis':'member','values':[0::BIGINT,1::BIGINT]}});
----
<REGEX>:(?i).*\[spatial_dependency\].*explicitly load.*matching.*

# An empty nearest collection still needs the representative-point adapter at bind time.
statement error
SELECT * FROM read_om_regions(
    '__WORKING_DIRECTORY__/test/data/regions/regions.om',
    regions := []::STRUCT(id VARCHAR,wkb BLOB)[], region_crs := 'grid_lonlat',
    dimensions := ['member','time','lat','lon'],
    grid := {'nx':5,'ny':5,'lat0':20.0,'lon0':100.0,'dlat':1.0,'dlon':1.0,'order':'separate'},
    spatial_axes := ['lat','lon'],
    axes := {
        'time':{'axis':'time','start':TIMESTAMP '2026-01-01 00:00:00','step':INTERVAL '1 hour'},
        'member':{'axis':'member','values':[0::BIGINT,1::BIGINT]}},
    method := 'nearest');
----
<REGEX>:(?i).*(spatial|extension).*(loaded|load).*
