# name: test/sql/grid_selection.test
# description: Compare version=1 spatial selection with full materialized results
# group: [duckomo]

require skip_reload

require allow_unsigned_extensions

statement ok
LOAD '__BUILD_DIRECTORY__/extension/duckomo/duckomo.duckdb_extension';

# Materialize the full unfiltered scan before any selection query runs.
statement ok
CREATE TEMP VIEW rotated_grid AS
SELECT humidity, pressure, temperature, latitude, longitude
FROM read_om(
    '__WORKING_DIRECTORY__/test/data/projection.om',
    dimensions := map(['humidity','pressure','temperature'],
                      [['row','column'],['row','column'],['row','column']]),
    grid := {
        'version': 1, 'type': 'rotated_latlon', 'numeric_policy': 'float64_v1',
        'earth': {'model': 'sphere', 'radius_m': 6371229.0},
        'layout': {'nx': 127, 'ny': 83, 'order': 'separate'},
        'parameters': {'x0': 0.0, 'y0': 0.0, 'dx': 1.0, 'dy': 1.0,
                       'north_pole_latitude': 90.0, 'north_pole_longitude': 0.0, 'rotation': 0.0}
    }, spatial_axes := ['row','column']);

statement ok
CREATE TEMP TABLE rotated_baseline AS SELECT * FROM rotated_grid;

# Simple comparisons, BETWEEN and a conjunction match the full baseline in both directions.
query II
SELECT
    (SELECT count(*) FROM (
        (SELECT temperature, latitude, longitude FROM rotated_baseline
         WHERE latitude >= 20 AND latitude <= 40 AND longitude BETWEEN 30 AND 50)
        EXCEPT ALL
        (SELECT temperature, latitude, longitude FROM rotated_grid
         WHERE latitude >= 20 AND latitude <= 40 AND longitude BETWEEN 30 AND 50))),
    (SELECT count(*) FROM (
        (SELECT temperature, latitude, longitude FROM rotated_grid
         WHERE latitude >= 20 AND latitude <= 40 AND longitude BETWEEN 30 AND 50)
        EXCEPT ALL
        (SELECT temperature, latitude, longitude FROM rotated_baseline
         WHERE latitude >= 20 AND latitude <= 40 AND longitude BETWEEN 30 AND 50)));
----
0	0

# Projected selectors are compared against independently materialized full scans
# for each projection family, not just the rotated-latitude fast path.
statement ok
CREATE TEMP VIEW lambert_grid AS
SELECT temperature, latitude, longitude
FROM read_om(
    '__WORKING_DIRECTORY__/test/data/projection.om',
    dimensions := map(['humidity','pressure','temperature'],
                      [['row','column'],['row','column'],['row','column']]),
    grid := {
        'version': 1, 'type': 'lambert_conformal_conic', 'numeric_policy': 'float64_v1',
        'earth': {'model': 'sphere', 'radius_m': 6371229.0},
        'layout': {'nx': 127, 'ny': 83, 'order': 'separate'},
        'parameters': {'x0': -63000.0, 'y0': -41000.0, 'dx': 1000.0, 'dy': 1000.0,
                       'central_meridian': 10.0, 'latitude_of_origin': 46.244,
                       'standard_parallel_1': 40.0, 'standard_parallel_2': 50.0}
    }, spatial_axes := ['row','column']);

statement ok
CREATE TEMP TABLE lambert_baseline AS SELECT * FROM lambert_grid;

query II
SELECT
    (SELECT count(*) FROM (
        (SELECT temperature, latitude, longitude FROM lambert_baseline
         WHERE latitude BETWEEN 45.5 AND 46.5 AND longitude BETWEEN 9.5 AND 10.5)
        EXCEPT ALL
        (SELECT temperature, latitude, longitude FROM lambert_grid
         WHERE latitude BETWEEN 45.5 AND 46.5 AND longitude BETWEEN 9.5 AND 10.5))),
    (SELECT count(*) FROM (
        (SELECT temperature, latitude, longitude FROM lambert_grid
         WHERE latitude BETWEEN 45.5 AND 46.5 AND longitude BETWEEN 9.5 AND 10.5)
        EXCEPT ALL
        (SELECT temperature, latitude, longitude FROM lambert_baseline
         WHERE latitude BETWEEN 45.5 AND 46.5 AND longitude BETWEEN 9.5 AND 10.5)));
----
0	0

statement ok
CREATE TEMP VIEW stereographic_grid AS
SELECT temperature, latitude, longitude
FROM read_om(
    '__WORKING_DIRECTORY__/test/data/projection.om',
    dimensions := map(['humidity','pressure','temperature'],
                      [['row','column'],['row','column'],['row','column']]),
    grid := {
        'version': 1, 'type': 'stereographic', 'numeric_policy': 'float64_v1',
        'earth': {'model': 'sphere', 'radius_m': 6371229.0},
        'layout': {'nx': 127, 'ny': 83, 'order': 'separate'},
        'parameters': {'x0': -63000.0, 'y0': -41000.0, 'dx': 1000.0, 'dy': 1000.0,
                       'central_meridian': 10.0, 'latitude_of_origin': 45.0, 'scale_factor': 1.0}
    }, spatial_axes := ['row','column']);

statement ok
CREATE TEMP TABLE stereographic_baseline AS SELECT * FROM stereographic_grid;

query II
SELECT
    (SELECT count(*) FROM (
        (SELECT temperature, latitude, longitude FROM stereographic_baseline
         WHERE latitude BETWEEN 44 AND 46 AND longitude BETWEEN 9 AND 11)
        EXCEPT ALL
        (SELECT temperature, latitude, longitude FROM stereographic_grid
         WHERE latitude BETWEEN 44 AND 46 AND longitude BETWEEN 9 AND 11))),
    (SELECT count(*) FROM (
        (SELECT temperature, latitude, longitude FROM stereographic_grid
         WHERE latitude BETWEEN 44 AND 46 AND longitude BETWEEN 9 AND 11)
        EXCEPT ALL
        (SELECT temperature, latitude, longitude FROM stereographic_baseline
         WHERE latitude BETWEEN 44 AND 46 AND longitude BETWEEN 9 AND 11)));
----
0	0

# Gaussian row selection also keeps its irregular source order against a full
# materialized oracle.
statement ok
CREATE TEMP VIEW gaussian_grid AS
SELECT "flattened_x_fastest/value" AS value, latitude, longitude
FROM read_om(
    '__WORKING_DIRECTORY__/test/data/grids/x-fastest.om',
    dimensions := map(['flattened_x_fastest/value'], [['point']]),
    grid := {
        'version': 1, 'type': 'reduced_gaussian', 'numeric_policy': 'float64_v1',
        'earth': {'model': 'wgs84', 'semi_major_m': 6378137.0, 'inverse_flattening': 298.257223563},
        'layout': {'order': 'row_major'},
        'parameters': {
            'n': 1, 'latitude_rule': 'explicit_v1',
            'rows': [{'latitude': 60.0, 'point_count': 6, 'longitude_origin': 0.0, 'longitude_step': 60.0},
                     {'latitude': -60.0, 'point_count': 6, 'longitude_origin': 0.0, 'longitude_step': 60.0}],
            'subset_segments': NULL
        }
    }, spatial_axes := ['point']);

statement ok
CREATE TEMP TABLE gaussian_baseline AS SELECT * FROM gaussian_grid;

# Full-domain predicates bypass coordinate preflight for Gaussian grids.
# Preparation contains only the 12 bind-time grid-coordinate validations.
query I
SELECT count(*) FROM gaussian_grid
WHERE latitude BETWEEN -90 AND 90 AND longitude >= -180 AND longitude < 180;
----
12

query I
SELECT count(*) FROM duckomo_last_scan_metrics()
WHERE scan_id = (SELECT max(scan_id) FROM duckomo_last_scan_metrics())
  AND metrics LIKE '%"coordinate_preparation":{"evaluations":12,"complete":true}%';
----
1

query II
SELECT
    (SELECT count(*) FROM (
        (SELECT value, latitude, longitude FROM gaussian_baseline
         WHERE latitude = 60 AND longitude BETWEEN 0 AND 60)
        EXCEPT ALL
        (SELECT value, latitude, longitude FROM gaussian_grid
         WHERE latitude = 60 AND longitude BETWEEN 0 AND 60))),
    (SELECT count(*) FROM (
        (SELECT value, latitude, longitude FROM gaussian_grid
         WHERE latitude = 60 AND longitude BETWEEN 0 AND 60)
        EXCEPT ALL
        (SELECT value, latitude, longitude FROM gaussian_baseline
         WHERE latitude = 60 AND longitude BETWEEN 0 AND 60)));
----
0	0

# The Float32 stereographic center uses the same longitude domain as other points.
statement ok
CREATE TEMP VIEW stereographic_f32_grid AS
SELECT value, latitude, longitude
FROM read_om(
    '__WORKING_DIRECTORY__/test/data/raw.om',
    dimensions := map(['value'], [['row', 'column']]),
    grid := {
        'version': 1, 'type': 'stereographic', 'numeric_policy': 'openmeteo_f32_v1',
        'earth': {'model': 'sphere', 'radius_m': 6371229.0},
        'layout': {'nx': 3, 'ny': 2, 'order': 'separate'},
        'parameters': {'x0': 0.0, 'y0': 0.0, 'dx': 1000.0, 'dy': 1000.0,
                       'central_meridian': 270.0, 'latitude_of_origin': 45.0, 'scale_factor': 1.0}
    }, spatial_axes := ['row', 'column']);

statement ok
CREATE TEMP TABLE stereographic_f32_baseline AS SELECT * FROM stereographic_f32_grid;

query RR
SELECT latitude, longitude FROM stereographic_f32_baseline WHERE value = 0;
----
45.000000	-90.000000

# Direct filtering and filtering the materialized scan agree at the center and outside the domain.
query IIII
SELECT
    (SELECT count(*) FROM stereographic_f32_baseline WHERE longitude > 180),
    (SELECT count(*) FROM stereographic_f32_grid WHERE longitude > 180),
    (SELECT count(*) FROM stereographic_f32_baseline WHERE longitude = -90 AND latitude = 45),
    (SELECT count(*) FROM stereographic_f32_grid WHERE longitude = -90 AND latitude = 45);
----
0	0	1	1

# Two safe longitude intervals on opposite sides of the normalized seam remain exact.
query II
SELECT
    (SELECT count(*) FROM (
        (SELECT humidity, latitude, longitude FROM rotated_baseline
         WHERE latitude BETWEEN 10 AND 30 AND (longitude >= 125 OR longitude < 3))
        EXCEPT ALL
        (SELECT humidity, latitude, longitude FROM rotated_grid
         WHERE latitude BETWEEN 10 AND 30 AND (longitude >= 125 OR longitude < 3)))),
    (SELECT count(*) FROM (
        (SELECT humidity, latitude, longitude FROM rotated_grid
         WHERE latitude BETWEEN 10 AND 30 AND (longitude >= 125 OR longitude < 3))
        EXCEPT ALL
        (SELECT humidity, latitude, longitude FROM rotated_baseline
         WHERE latitude BETWEEN 10 AND 30 AND (longitude >= 125 OR longitude < 3))));
----
0	0

# An unsafe OR branch remains a residual predicate while its conservative fallback stays exact.
query I
SELECT count(*) FROM (
    (SELECT pressure, latitude, longitude FROM rotated_baseline
     WHERE longitude >= 125 OR humidity = 0)
    EXCEPT ALL
    (SELECT pressure, latitude, longitude FROM rotated_grid
     WHERE longitude >= 125 OR humidity = 0));
----
0

query I
SELECT count(*) FROM duckomo_last_scan_metrics()
WHERE metrics LIKE '%"selection_mode":"fallback"%'
  AND metrics LIKE '%unsafe_or_expression%';
----
1

# Reversed BETWEEN is kept by DuckDB and agrees with the fully materialized result.
query II
SELECT
    (SELECT count(*) FROM (
        (SELECT temperature, longitude FROM rotated_baseline WHERE 25 BETWEEN latitude AND longitude)
        EXCEPT ALL
        (SELECT temperature, longitude FROM rotated_grid WHERE 25 BETWEEN latitude AND longitude))),
    (SELECT count(*) FROM (
        (SELECT temperature, longitude FROM rotated_grid WHERE 25 BETWEEN latitude AND longitude)
        EXCEPT ALL
        (SELECT temperature, longitude FROM rotated_baseline WHERE 25 BETWEEN latitude AND longitude)));
----
0	0

# Output expressions, duplicate coordinate references, ordering and aggregation use the same selected rows.
query I
SELECT count(*) FROM (
    (SELECT count(*), min(temperature + pressure), max(temperature + pressure)
     FROM rotated_baseline
     WHERE latitude BETWEEN 20 AND 40 AND longitude BETWEEN 30 AND 50 AND humidity % 2 = 0)
    EXCEPT ALL
    (SELECT count(*), min(temperature + pressure), max(temperature + pressure)
     FROM rotated_grid
     WHERE latitude BETWEEN 20 AND 40 AND longitude BETWEEN 30 AND 50 AND humidity % 2 = 0));
----
0

query I
SELECT count(*) FROM (
    SELECT longitude, temperature, latitude, longitude
    FROM rotated_grid
    WHERE latitude BETWEEN 20 AND 40 AND longitude BETWEEN 30 AND 50
    ORDER BY temperature);
----
400

# Semantic axes may surround the spatial axes. A filter-only value variable
# remains a residual dependency while output values retain every source index.
statement ok
CREATE TEMP VIEW interleaved_grid AS
SELECT "interleaved/temperature" AS temperature, "interleaved/humidity" AS humidity,
       latitude, longitude
FROM read_om(
    '__WORKING_DIRECTORY__/test/data/grids/interleaved.om',
    dimensions := map(
        ['interleaved/temperature', 'interleaved/humidity'],
        [['time', 'latitude_axis', 'level', 'longitude_axis', 'lead_time', 'member', 'run'],
         ['time', 'latitude_axis', 'level', 'longitude_axis', 'lead_time', 'member', 'run']]),
    grid := {
        'version': 1, 'type': 'rotated_latlon', 'numeric_policy': 'float64_v1',
        'earth': {'model': 'sphere', 'radius_m': 6371229.0},
        'layout': {'nx': 4, 'ny': 3, 'order': 'separate'},
        'parameters': {'x0': 0.0, 'y0': 0.0, 'dx': 1.0, 'dy': 1.0,
                       'north_pole_latitude': 90.0, 'north_pole_longitude': 0.0, 'rotation': 0.0}
    }, spatial_axes := ['latitude_axis', 'longitude_axis']);

statement ok
CREATE TEMP TABLE interleaved_baseline AS SELECT * FROM interleaved_grid;

query II
SELECT
    (SELECT count(*) FROM (
        (SELECT humidity, latitude, longitude
         FROM interleaved_baseline
         WHERE latitude BETWEEN 1 AND 2 AND longitude BETWEEN 1 AND 3
           AND temperature > 100000)
        EXCEPT ALL
        (SELECT humidity, latitude, longitude
         FROM interleaved_grid
         WHERE latitude BETWEEN 1 AND 2 AND longitude BETWEEN 1 AND 3
           AND temperature > 100000))),
    (SELECT count(*) FROM (
        (SELECT humidity, latitude, longitude
         FROM interleaved_grid
         WHERE latitude BETWEEN 1 AND 2 AND longitude BETWEEN 1 AND 3
           AND temperature > 100000)
        EXCEPT ALL
        (SELECT humidity, latitude, longitude
         FROM interleaved_baseline
         WHERE latitude BETWEEN 1 AND 2 AND longitude BETWEEN 1 AND 3
           AND temperature > 100000)));
----
0	0
