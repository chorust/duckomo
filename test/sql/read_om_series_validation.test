# name: test/sql/read_om_series_validation.test
# description: Reject invalid read_om_series arguments and incompatible object schemas
# group: [duckomo]

require skip_reload

require allow_unsigned_extensions

statement ok
LOAD '__BUILD_DIRECTORY__/extension/duckomo/duckomo.duckdb_extension';

# A file path is not a directory prefix.
statement error
SELECT * FROM read_om_series(
    '__WORKING_DIRECTORY__/build/series-fixtures/data/synthetic/temperature/chunk_0000.om',
    chunk_time_length := 4, time_step := INTERVAL '1 hour',
    dimensions := ['lead','point','time'], grid := {'nx':3,'ny':2,'lat0':10.0,'lon0':100.0,'dlat':1.0,'dlon':1.0,'order':'lon_fastest'},
    spatial_axes := ['point'], valid_times := [TIMESTAMP '1970-01-01', TIMESTAMP '1970-01-01 01:00:00']
);
----
<REGEX>:(?i).*(prefix|directory).*

statement error
SELECT * FROM read_om_series('', chunk_time_length := 4, time_step := INTERVAL '1 hour',
    dimensions := ['lead','point','time'], grid := {'nx':3,'ny':2,'lat0':10.0,'lon0':100.0,'dlat':1.0,'dlon':1.0,'order':'lon_fastest'},
    spatial_axes := ['point'], valid_times := [TIMESTAMP '1970-01-01', TIMESTAMP '1970-01-01 01:00:00']);
----
<REGEX>:(?i).*(prefix|directory).*

statement error
