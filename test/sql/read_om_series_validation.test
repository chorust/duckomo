# Registered defaults and independent overrides preserve the exact ordinary-read row multiset.
query I
WITH registered AS (
    SELECT * FROM read_om_series(
        '__WORKING_DIRECTORY__/build/series-fixtures/data/synthetic/temperature',
        model := 'ecmwf_ifs', chunk_time_length := 4,
        dimensions := ['lead','point','time'],
        grid := {'nx':3,'ny':2,'lat0':10.0,'lon0':100.0,'dlat':1.0,'dlon':1.0,'order':'lon_fastest'},
        spatial_axes := ['point'], valid_times := [TIMESTAMP '1970-01-01', TIMESTAMP '1970-01-01 01:00:00']
    )
), manual AS (
    SELECT * FROM read_om_series(
        '__WORKING_DIRECTORY__/build/series-fixtures/data/synthetic/temperature',
        chunk_time_length := 4, time_step := INTERVAL '1 hour',
        dimensions := ['lead','point','time'],
        grid := {'nx':3,'ny':2,'lat0':10.0,'lon0':100.0,'dlat':1.0,'dlon':1.0,'order':'lon_fastest'},
        spatial_axes := ['point'], valid_times := [TIMESTAMP '1970-01-01', TIMESTAMP '1970-01-01 01:00:00']
    )
)
SELECT
    (SELECT count(*) FROM (SELECT * FROM registered EXCEPT ALL SELECT * FROM manual) AS left_only) +
    (SELECT count(*) FROM (SELECT * FROM manual EXCEPT ALL SELECT * FROM registered) AS right_only);
----
0

query I
WITH registered AS (
    SELECT * FROM read_om_series(
        '__WORKING_DIRECTORY__/build/series-fixtures/data/synthetic/temperature',
        model := 'ecmwf_ifs', chunk_time_length := 4, time_step := INTERVAL '1 hour',
        dimensions := ['lead','point','time'],
        grid := {'nx':3,'ny':2,'lat0':10.0,'lon0':100.0,'dlat':1.0,'dlon':1.0,'order':'lon_fastest'},
        spatial_axes := ['point'], valid_times := [TIMESTAMP '1970-01-01', TIMESTAMP '1970-01-01 01:00:00']
    )
), custom AS (
    SELECT * FROM read_om_series(
        '__WORKING_DIRECTORY__/build/series-fixtures/data/synthetic/temperature',
        model := 'future_model', chunk_time_length := 4, time_step := INTERVAL '1 hour',
        dimensions := ['lead','point','time'],
        grid := {'nx':3,'ny':2,'lat0':10.0,'lon0':100.0,'dlat':1.0,'dlon':1.0,'order':'lon_fastest'},
        spatial_axes := ['point'], valid_times := [TIMESTAMP '1970-01-01', TIMESTAMP '1970-01-01 01:00:00']
    )
)
SELECT
    (SELECT count(*) FROM (SELECT * FROM registered EXCEPT ALL SELECT * FROM custom) AS left_only) +
    (SELECT count(*) FROM (SELECT * FROM custom EXCEPT ALL SELECT * FROM registered) AS right_only);
