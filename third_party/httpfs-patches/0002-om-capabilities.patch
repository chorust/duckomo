 namespace duckdb {
 
+struct HTTPFSOmRangeCapabilitiesState final : GlobalTableFunctionState {
+	bool emitted = false;
+};
+
+static unique_ptr<GlobalTableFunctionState> HTTPFSOmRangeCapabilitiesInit(ClientContext &, TableFunctionInitInput &) {
+	return make_uniq<HTTPFSOmRangeCapabilitiesState>();
+}
+
+static void HTTPFSOmRangeCapabilitiesFunction(ClientContext &, TableFunctionInput &input, DataChunk &output) {
+	auto &state = input.global_state->Cast<HTTPFSOmRangeCapabilitiesState>();
+	if (state.emitted) return;
+	output.data[0].SetValue(0, Value::INTEGER(HTTPFS_OM_RANGE_CAPABILITIES_V2.abi_version));
+	output.data[1].SetValue(0, Value(HTTPFS_OM_RANGE_CAPABILITIES_V2.upstream_commit));
+	output.data[2].SetValue(0, Value(HTTPFS_OM_RANGE_CAPABILITIES_V2.patch_revision));
+	output.SetCardinality(1);
+	state.emitted = true;
+}
+
+static unique_ptr<FunctionData> HTTPFSOmRangeCapabilitiesBind(ClientContext &, TableFunctionBindInput &,
+	                                                           vector<LogicalType> &return_types,
+	                                                           vector<string> &names) {
+	return_types = {LogicalType::INTEGER, LogicalType::VARCHAR, LogicalType::VARCHAR};
+	names = {"abi_version", "upstream_commit", "patch_revision"};
+	return nullptr;
+}
+
 static void ClearHTTPFSConnectionCacheFunction(ClientContext &context, TableFunctionInput &, DataChunk &) {
 	auto &config = DBConfig::GetConfig(context);
 	auto &httpfs_util = static_cast<HTTPFSUtil &>(config.GetHTTPUtil());
@@ -191,6 +218,11 @@ static void LoadInternal(ExtensionLoader &loader) {
 
 	CreateS3SecretFunctions::Register(loader);
 	CreateBearerTokenFunctions::Register(loader);
+	TableFunction capabilities("httpfs_om_range_capabilities", {}, HTTPFSOmRangeCapabilitiesFunction,
+	                            HTTPFSOmRangeCapabilitiesBind);
+	capabilities.extra_info = HTTPFS_OM_RANGE_CAPABILITY_DESCRIPTOR;
+	capabilities.init_global = HTTPFSOmRangeCapabilitiesInit;
+	loader.RegisterFunction(capabilities);
 
 #ifdef OVERRIDE_ENCRYPTION_UTILS
 	// set pointer to OpenSSL encryption state
