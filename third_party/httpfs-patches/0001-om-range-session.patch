+static std::atomic<uint64_t> om_range_request_ids {1};
+
+static void ApplyOmRangeHeaders(HTTPHeaders &headers, const std::map<std::string, std::string> &additions) {
+	for (const auto &entry : additions) {
+		headers.Insert(entry.first, entry.second);
+	}
+}
+
+static std::map<std::string, std::string> OmRangeResponseHeaders(const HTTPResponse &response) {
+	std::map<std::string, std::string> result;
+	for (const auto *name : {"Content-Range", "Content-Length", "Content-Encoding", "ETag", "x-amz-version-id"}) {
+		if (response.HasHeader(name)) {
+			result.emplace(name, response.GetHeaderValue(name));
+		}
+	}
+	return result;
+}
+
+static string ResolveOmRangeRedirect(const string &from_url, const string &location) {
+	if (location.find("://") != string::npos) return location;
+	string path;
+	string origin;
+	HTTPUtil::DecomposeURL(from_url, path, origin);
+	if (StringUtil::StartsWith(location, "//")) {
+		const auto scheme_end = from_url.find(':');
+		if (scheme_end == string::npos) throw HTTPException("DuckOMO rejected a malformed redirect");
+		return from_url.substr(0, scheme_end + 1) + location;
+	}
+	if (StringUtil::StartsWith(location, "/")) return origin + location;
+	if (StringUtil::StartsWith(location, "?")) {
+		const auto query = path.find('?');
+		if (query != string::npos) path.resize(query);
+		return origin + path + location;
+	}
+	const auto query = path.find('?');
+	if (query != string::npos) path.resize(query);
+	const auto slash = path.rfind('/');
+	if (slash != string::npos) path.resize(slash + 1);
+	return origin + path + location;
+}
+
+static HTTPFSOmRequestV2 MakeOmRangeRequest(HTTPFSOmRangeSessionV2 &session, const string &method,
+	                                          const string &url, bool has_range, uint64_t offset,
+	                                          uint64_t length) {
+	HTTPFSOmRequestV2 request;
+	request.request_id = om_range_request_ids.fetch_add(1);
+	request.method = method;
+	request.uri = session.Identity().canonical_uri;
+	request.has_range = has_range;
+	request.range_offset = offset;
+	request.range_length = length;
+	request.read_class = session.CurrentReadClass();
+	(void)url; // The observer receives only the sanitized canonical URI.
+	return request;
+}
+
+static void ValidateOmRangeResponse(const HTTPFSOmRangeIdentityV2 &identity, const HTTPResponse &response,
+	                                  uint64_t offset, uint64_t length) {
+	if (response.status != HTTPStatusCode::PartialContent_206) {
+		throw HTTPException("DuckOMO range session requires HTTP 206 responses");
+	}
+	if (length == 0 || offset > identity.object_size || length > identity.object_size - offset) {
+		throw HTTPException("DuckOMO range session requested bytes outside the bound object");
+	}
+	const auto expected = "bytes " + to_string(offset) + "-" + to_string(offset + length - 1) + "/" +
+	                      to_string(identity.object_size);
+	if (!response.HasHeader("Content-Range") || response.GetHeaderValue("Content-Range") != expected) {
+		throw HTTPException("DuckOMO range session received an invalid Content-Range");
+	}
+	if (response.HasHeader("Content-Length")) {
+		try {
+			if (std::stoull(response.GetHeaderValue("Content-Length")) != length) {
+				throw HTTPException("DuckOMO range session received an invalid Content-Length");
+			}
+		} catch (const HTTPException &) {
+			throw;
+		} catch (...) {
+			throw HTTPException("DuckOMO range session received an invalid Content-Length");
+		}
+	}
+	if (response.HasHeader("Content-Encoding") && response.GetHeaderValue("Content-Encoding") != "identity") {
+		throw HTTPException("DuckOMO range session requires identity transfer encoding");
+	}
+	if (identity.version_kind == HTTPFSOmVersionKindV2::StrongETag) {
+		if (!response.HasHeader("ETag") || response.GetHeaderValue("ETag") != identity.version_token) {
+			throw HTTPException("DuckOMO range session observed an ETag change");
+		}
+	} else if (identity.version_kind == HTTPFSOmVersionKindV2::S3VersionId) {
+		if (!response.HasHeader("x-amz-version-id") ||
+		    response.GetHeaderValue("x-amz-version-id") != identity.version_token) {
+			throw HTTPException("DuckOMO range session observed an S3 version change");
+		}
+	}
+}
