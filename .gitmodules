[submodule "duckdb"]
	path = duckdb
	url = https://github.com/duckdb/duckdb.git
[submodule "third_party/om-file-format"]
	path = third_party/om-file-format
	url = https://github.com/open-meteo/om-file-format.git
[submodule "extension-ci-tools"]
	path = extension-ci-tools
	url = https://github.com/duckdb/extension-ci-tools.git
[submodule "third_party/duckdb-httpfs"]
	path = third_party/duckdb-httpfs
	url = https://github.com/duckdb/duckdb-httpfs.git
[submodule "speckit-roadmap-extension"]
	path = .specify/extensions/roadmap
	url = https://github.com/srobroek/speckit-roadmap.git
